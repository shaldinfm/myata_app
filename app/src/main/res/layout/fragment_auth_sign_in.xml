<?xml version="1.0" encoding="utf-8"?>
<!--
  auth-sign-in 2517:2603 (light) / 2517:3570 (dark), 390x576.

  A pushed destination like profile-guest: a back button in the band, no bottom
  bar. MainActivity hides the bar for this destination alongside the profile.

  ## Geometry

  Absolute Figma offsets, so the screen can be checked by adding the margins up:

      band            0..64
      b0             92..114   (28 below the band)
      b1            114..136   (contiguous - the designer's line break)
      Label Email   156..176   (20 below the paragraph)
      Input Email   180..236   (4 below its label)
      Label Пароль  252..272   (16 below the input)
      Input Пароль  276..332   (4)
      Забыли пароль 344..364   (12 below the input, right-aligned)
      Войти         388..440   (24)
      Создать       456..508   (16)
      Продолжить    532..552   (24, centred)

  Content ends at 552 inside a 576 frame. The ScrollView is not decoration: at
  360dp the two body lines occupy more height than they do here, and a screen
  whose primary button cannot be reached is worse than one that scrolls.

  ## The two error TextViews are `gone`

  No approved Figma frame draws an auth error, so the inline copy is drawn in this
  screen's own type and colour and is `gone` until something fails - which is what
  keeps every measurement above exactly as Figma has it in the resting state.

  ## The button reuses profile-guest's drawable

  `bg_profile_button_primary` and `bg_profile_button_secondary` are the same
  component at the same 358x52 with the same 12dp radius and the same tokens; the
  design system has one Button and these two screens draw it. A private copy here
  would be a second place for it to drift.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/auth_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        tools:context=".fragments.AuthSignInFragment">

        <!-- `Header - TopAppBar` 390x64, identical to profile-guest's. -->
        <LinearLayout
            android:id="@+id/auth_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/profile_back_margin_start"
            android:paddingEnd="@dimen/profile_margin">

            <ImageView
                android:id="@+id/auth_back"
                android:layout_width="@dimen/profile_back_size"
                android:layout_height="@dimen/profile_back_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_back_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/profile_title_margin_start"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/auth_sign_in_title"
                android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                android:textColor="@color/text_heading" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/auth_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/content_bottom_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/profile_margin"
                android:paddingEnd="@dimen/profile_margin">

                <!--
                  Two nodes in Figma, contiguous at 92 and 114 - one sentence broken
                  where the design breaks it, so the wrap is the designer's rather
                  than the measure's. Same treatment as profile-guest's body.
                -->
                <TextView
                    android:id="@+id/auth_body_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_body_box"
                    android:layout_marginTop="@dimen/auth_first_row_margin_top"
                    android:text="@string/auth_sign_in_body_first"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_body_second"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_body_box"
                    android:text="@string/auth_sign_in_body_second"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_email_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_body_to_label"
                    android:labelFor="@+id/auth_email"
                    android:text="@string/auth_label_email"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <!--
                  `Input / Email` 358x56, r=12. The value sits at x=16, y=17 inside
                  it, and 17 is (56 - 22) / 2 - the 22dp line box centred - so the
                  field centres its text vertically rather than padding to a number.
                -->
                <EditText
                    android:id="@+id/auth_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/auth_hint_email"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="@dimen/auth_input_padding_horizontal"
                    android:paddingEnd="@dimen/auth_input_padding_horizontal"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_email_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_email_format"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/auth_password_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:labelFor="@+id/auth_password"
                    android:text="@string/auth_label_password"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <!--
                  No show/hide affordance. The frame draws ten bullets and nothing
                  else, and adding an eye would be inventing a control the design
                  does not have on a screen that is being matched pixel for pixel.
                -->
                <EditText
                    android:id="@+id/auth_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/auth_hint_password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="@dimen/auth_input_padding_horizontal"
                    android:paddingEnd="@dimen/auth_input_padding_horizontal"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_password_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_password_short"
                    tools:visibility="visible" />

                <!--
                  Right-aligned, per the frame. Present and deliberately not
                  interactive until G-A4c2 builds recovery: password recovery is
                  part of v1, so removing the control would misrepresent the
                  product, and leaving it tappable-but-inert would misrepresent the
                  build. Disabled says exactly what is true.
                -->
                <TextView
                    android:id="@+id/auth_forgot_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_forgot_margin_top"
                    android:clickable="false"
                    android:enabled="false"
                    android:focusable="false"
                    android:gravity="end|center_vertical"
                    android:text="@string/auth_forgot_password"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/primary" />

                <!-- The one inline area every remote failure lands in. -->
                <TextView
                    android:id="@+id/auth_form_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_invalid_credentials"
                    tools:visibility="visible" />

                <!--
                  `Button` 358x52. The FrameLayout is the control; the label and the
                  indicator share its centre so a request in flight swaps one for the
                  other without moving anything.
                -->
                <FrameLayout
                    android:id="@+id/auth_submit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_button_height"
                    android:layout_marginTop="@dimen/auth_primary_margin_top"
                    android:background="@drawable/bg_profile_button_primary"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/auth_submit_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/auth_sign_in_action"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.21_28"
                        android:textColor="@color/profile_primary_button_label" />

                    <ProgressBar
                        android:id="@+id/auth_submit_progress"
                        android:layout_width="@dimen/auth_progress_size"
                        android:layout_height="@dimen/auth_progress_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/auth_progress_description"
                        android:indeterminateTint="@color/profile_primary_button_label"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/auth_create_account"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_button_height"
                    android:layout_marginTop="@dimen/auth_secondary_margin_top"
                    android:background="@drawable/bg_profile_button_secondary"
                    android:gravity="center"
                    android:text="@string/auth_create_account_action"
                    android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.21_28"
                    android:textColor="@color/text_heading" />

                <TextView
                    android:id="@+id/auth_continue_as_guest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_guest_margin_top"
                    android:gravity="center"
                    android:text="@string/auth_continue_as_guest"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
