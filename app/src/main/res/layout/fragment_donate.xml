<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.DonateFragment"
        android:background="#1C3F5F"
        android:orientation="vertical">

        <TextView
                android:layout_marginTop="70dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="26.5sp"
                android:text="ПОМОЧЬ ПРОЕКТУ"
                android:gravity="center"
                android:id="@+id/title"
                android:fontFamily="@font/montserrat_black"
                android:textColor="#FFFFFF" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40">
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <WebView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/webView"
                        android:visibility="gone"
                        tools:ignore="Suspicious0dp" />

                    <LinearLayout
                        android:id="@+id/form"
                        android:layout_height="match_parent"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        tools:ignore="Suspicious0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp">

                            <HorizontalScrollView
                                android:id="@+id/summs"
                                android:layout_width="match_parent"
                                android:layout_height="65dp"
                                android:scrollbars="none"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:paddingStart="21dp"
                                    android:paddingEnd="21dp"
                                    android:gravity="center_vertical">

                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/sum100"
                                        android:layout_width="110dp"
                                        android:layout_height="58dp"
                                        android:layout_marginEnd="8dp"
                                        android:background="@drawable/summ"
                                        android:fontFamily="@font/montserrat_black"
                                        android:text="100"
                                        android:textColor="#1C4771"
                                        android:textSize="24sp" />

                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/sum200"
                                        android:layout_width="110dp"
                                        android:layout_height="58dp"
                                        android:layout_marginEnd="8dp"
                                        android:background="@drawable/summ"
                                        android:fontFamily="@font/montserrat_black"
                                        android:text="200"
                                        android:textColor="#1C4771"
                                        android:textSize="24sp" />

                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/sum500"
                                        android:layout_width="110dp"
                                        android:layout_height="58dp"
                                        android:layout_marginEnd="8dp"
                                        android:background="@drawable/summ"
                                        android:fontFamily="@font/montserrat_black"
                                        android:text="500"
                                        android:textColor="#1C4771"
                                        android:textSize="24sp" />

                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/sum1000"
                                        android:layout_width="110dp"
                                        android:layout_height="58dp"
                                        android:layout_marginEnd="8dp"
                                        android:background="@drawable/summ"
                                        android:fontFamily="@font/montserrat_black"
                                        android:text="1000"
                                        android:textColor="#1C4771"
                                        android:textSize="24sp" />

                                    <FrameLayout
                                        android:id="@+id/sum0_group"
                                        android:layout_width="110dp"
                                        android:layout_height="58dp"
                                        android:layout_marginStart="4dp">

                                        <TextView
                                            android:id="@+id/sum0_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@drawable/summ"
                                            android:fontFamily="@font/montserrat_black"
                                            android:gravity="center"
                                            android:text="ДРУГАЯ\nСУММА"
                                            android:textColor="#1C4771"
                                            android:textSize="14sp"
                                            android:visibility="visible" />

                                        <EditText
                                            android:id="@+id/sum0_input"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@drawable/summ_green"
                                            android:digits="0123456789"
                                            android:fontFamily="@font/montserrat_black"
                                            android:gravity="center"
                                            android:hint="₽"
                                            android:inputType="number"
                                            android:textColor="#1C4771"
                                            android:textColorHint="#991C4771"
                                            android:textSize="16sp"
                                            android:visibility="gone" />

                                    </FrameLayout>

                                </LinearLayout>

                            </HorizontalScrollView>

                        </androidx.constraintlayout.widget.ConstraintLayout>



                        <EditText
                            android:paddingTop="15dp"
                            android:layout_marginStart="21dp"
                            android:layout_marginEnd="21dp"
                            android:hint="Комментарий"
                            android:fontFamily="@font/onest_regular"
                            android:gravity="top"
                            android:maxHeight="164dp"
                            android:layout_height="wrap_content"
                            android:id="@+id/comment_text"
                            android:background="@drawable/comment_bg"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:layout_width="match_parent" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:fontFamily="@font/montserrat_black"
                            android:textAllCaps="false"
                            android:id="@+id/sendBtn"
                            android:text="ПОДДЕРЖАТЬ МЯТУ"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:layout_height="70dp"
                            android:layout_width="match_parent"
                            android:layout_marginStart="21dp"
                            android:layout_marginEnd="21dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/send_btn"/>

                        <HorizontalScrollView
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:layout_marginTop="30dp"
                            android:orientation="horizontal"
                            android:id="@+id/boosty_banners"
                            android:scrollbars="none"
                            android:paddingBottom="80dp">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="150dp"
                                    android:layout_marginStart="21dp"
                                    android:layout_marginEnd="7dp"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="4dp"
                                    app:cardBackgroundColor="@android:color/transparent">
                                    <ImageView
                                        android:id="@+id/boosty_79_banner"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:src="@drawable/boosty_79"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="Boosty 79₽"/>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="150dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginEnd="7dp"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="4dp"
                                    app:cardBackgroundColor="@android:color/transparent">
                                    <ImageView
                                        android:id="@+id/boosty_249_banner"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:src="@drawable/boosty_249"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="Boosty 249₽"/>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="150dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginEnd="7dp"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="4dp"
                                    app:cardBackgroundColor="@android:color/transparent">
                                    <ImageView
                                        android:id="@+id/boosty_499_banner"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:src="@drawable/boosty_499"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="Boosty 499₽"/>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="150dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginEnd="21dp"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="4dp"
                                    app:cardBackgroundColor="@android:color/transparent">
                                    <ImageView
                                        android:id="@+id/boosty_1499_banner"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:src="@drawable/boosty_1499"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="Boosty 1499₽"/>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                        </HorizontalScrollView>

                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>