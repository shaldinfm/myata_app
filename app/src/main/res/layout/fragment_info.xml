<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C3F5F"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="ТВОЯ МУЗЫКА.\nТВОЯ СТАНЦИЯ."
                android:gravity="center"
                android:textColor="#F5F7FA"
                android:fontFamily="@font/mullerblack"
                android:textSize="26.5sp"
                android:layout_marginTop="70dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <GridLayout
                android:id="@+id/grid"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/yandex"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/yandex_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/instagram"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/insta_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/boosty"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/boosty_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/tiktok"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/tiktok_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/youtube"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/youtube_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/twitter"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/twitter_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/telegram"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/telegram_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

                <ImageView
                    android:id="@+id/spotify"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/spotify_info"
                    android:scaleType="fitCenter"
                    android:layout_margin="4dp" />

            </GridLayout>

            <!-- Description with border frame -->
            <TextView
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/info_description_frame"
                android:padding="20dp"
                android:text="Радио Мята — интернет-радиостанция, ориентированная на инди-музыку и альтернативный рок.\n\nЭто «инди-эклектичное» медиа, предлагающее ироничный взгляд на массовую культуру и оригинальный подход к современной музыке. Станция начала вещание в ночь с 27 на 28 сентября 2017 года.\n\nДополнительно доступны тематические потоки:\nGOLD — «золотые» танцевальные хиты;\nXTRA — новая локальная инди-музыка;"
                android:textColor="#F5F7FA"
                android:fontFamily="@font/mullerregular"
                android:textSize="17sp"
                android:gravity="start"
                android:lineSpacingExtra="5dp"
                app:layout_constraintTop_toBottomOf="@id/grid"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="80dp"
                app:layout_constraintVertical_bias="0" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>