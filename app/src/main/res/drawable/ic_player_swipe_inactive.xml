<?xml version="1.0" encoding="utf-8"?>
<!--
  PLAYER swipe indicator, inactive page.

    `swipe > Shape Set`   INSTANCE, variant Shape = "Circle"
    `Shape Set > shape`   VECTOR 8.42 x 8.42 at (0.79, 0.79) of the 10x10 slot

  A plain circle, 8.42 across, centred in its slot - unlike the active marker,
  which is a nine-lobed cookie. Two arcs rather than one: a single 360 arc is
  degenerate.

  The colour is the one thing the two frozen pages disagree on. Light draws it as
  `primary` at 50% opacity, Dark as a solid `#6F899F`, so it is a declared pair
  (`player_swipe_inactive`) rather than one role - see docs/PLAYER-3.6.6.md.

  Untinted: the colour is applied from the layout.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="@dimen/player_swipe_shape_size"
    android:height="@dimen/player_swipe_shape_size"
    android:viewportWidth="8.42"
    android:viewportHeight="8.42">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,4.21 A4.21,4.21 0 1 0 8.42,4.21 A4.21,4.21 0 1 0 0,4.21 Z" />
</vector>
