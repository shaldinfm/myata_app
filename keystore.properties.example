# Release signing configuration — LOCAL ONLY.
#
# 1. Copy this file to keystore.properties in the project root.
# 2. Fill in the values locally. Ask the project owner for the real ones.
# 3. keystore.properties is gitignored and must NEVER be committed.
#
# storeFile: path to the keystore file (absolute, or relative to the project root).
# Debug builds do not need this file at all.

storeFile=
storePassword=
keyAlias=
keyPassword=
