<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen История эфира row card (G4b): `History Item / …` in history-content
  2523:23 and `Skeleton N` in history-loading 2517:2420 - 358 wide, r8, a 1px
  INSIDE stroke on `outline` (#E1E3E4 light / #466D8F dark) and no fill, so the
  screen's own `background` shows through.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/history_screen_row_stroke"
        android:color="@color/outline" />
    <corners android:radius="@dimen/history_screen_row_corner" />
</shape>
