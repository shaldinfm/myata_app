<?xml version="1.0" encoding="utf-8"?>
<!--
  ABOUT US, "Разово" chip on the one-time card. Frozen 2411:31652 / 2444:18597.
  Unlike the Boosty chip its fill tracks no role in either theme, so both fill
  and stroke are pairs - see values/colors.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/about_onetime_chip_container" />
    <stroke android:width="1dp" android:color="@color/about_onetime_chip_outline" />
    <corners android:radius="@dimen/about_chip_corner" />
</shape>
