<?xml version="1.0" encoding="utf-8"?>
<!--
  COLLECTION header overflow.

  Frozen canonical: `COLLECTION` > `Header - TopAppBar` > `Button:margin` >
  `Button` > `Container` > `Icon`, a 4x16 dot column. Three 4-wide dots on a 16
  column leave a 2 gap between them, which is what is drawn here, centred in a
  24 canvas so the glyph measures 4x16 inside the 48dp touch target.

  The canonical exporter records a vector's box and fills but never its geometry
  - there is no vectorPaths in canonical/code.js - so the dots are authored from
  the box, exactly as the Mini Player's play and pause glyphs were.

  Tint comes from the view; the fill here is only what an untinted preview shows.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/collection_header_action">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,6 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,12 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,18 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
</vector>
