<?xml version="1.0" encoding="utf-8"?>
<!--
  auth-create-account 2517:2624 (light) / 2517:3591 (dark), 390x596.

  The sibling of auth-sign-in and built the same way: same band, same 16dp side
  margin, same 56dp inputs, same 52dp button. Three fields instead of two, a rule
  under the password instead of a recovery link, and one button instead of two.

  ## Geometry

      band            0..64
      Label Имя      92..112   (28 below the band)
      Input Имя     116..172   (4 below its label)
      Label Email   188..208   (16 below the input)
      Input Email   212..268   (4)
      Label Пароль  284..304   (16)
      Input Пароль  308..364   (4)
      Минимум 8      372..392   (8 below the input)
      Создать       412..464   (20)
      Уже есть      488..508   (24, centred)

  Content ends at 508 inside a 596 frame.

  ## The password field is drawn focused

  2517:2638 has a 2dp `primary` stroke where every other input has a 1dp
  `outline` one, and a placeholder rather than a value. That is the focused state,
  and `bg_auth_input` reproduces it as a state rather than as this field's
  permanent appearance - which is what the frame is showing, not what the field
  always looks like.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/auth_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        tools:context=".fragments.AuthCreateAccountFragment">

        <LinearLayout
            android:id="@+id/auth_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/profile_back_margin_start"
            android:paddingEnd="@dimen/profile_margin">

            <ImageView
                android:id="@+id/auth_back"
                android:layout_width="@dimen/profile_back_size"
                android:layout_height="@dimen/profile_back_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_back_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/profile_title_margin_start"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/auth_create_account_title"
                android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                android:textColor="@color/text_heading" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/auth_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/content_bottom_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/profile_margin"
                android:paddingEnd="@dimen/profile_margin">

                <TextView
                    android:id="@+id/auth_name_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_first_row_margin_top"
                    android:labelFor="@+id/auth_name"
                    android:text="@string/auth_label_name"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <!--
                  `Имя` goes to user_metadata.display_name, which has no uniqueness
                  rule and no profiles table behind it. textPersonName, so the
                  keyboard capitalises a name and does not try to correct it into a
                  dictionary word.
                -->
                <EditText
                    android:id="@+id/auth_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/auth_hint_name"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingStart="@dimen/auth_input_padding_horizontal"
                    android:paddingEnd="@dimen/auth_input_padding_horizontal"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_name_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_name_blank"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/auth_email_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:labelFor="@+id/auth_email"
                    android:text="@string/auth_label_email"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/auth_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/auth_hint_email"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="@dimen/auth_input_padding_horizontal"
                    android:paddingEnd="@dimen/auth_input_padding_horizontal"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_email_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_email_format"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/auth_password_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:labelFor="@+id/auth_password"
                    android:text="@string/auth_label_password"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/auth_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="center_vertical"
                    android:hint="@string/auth_hint_password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="@dimen/auth_input_padding_horizontal"
                    android:paddingEnd="@dimen/auth_input_padding_horizontal"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_password_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_password_short"
                    tools:visibility="visible" />

                <!--
                  The rule the design states, and the only password rule this app
                  enforces locally. Anything stronger would be invented here rather
                  than required by Supabase, and a client that refuses what the
                  server would have accepted is a client telling the listener a
                  policy that does not exist.
                -->
                <TextView
                    android:id="@+id/auth_password_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_hint_margin_top"
                    android:text="@string/auth_password_hint_rule"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/auth_form_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_error_margin_top"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/auth_error_email_taken"
                    tools:visibility="visible" />

                <FrameLayout
                    android:id="@+id/auth_submit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_button_height"
                    android:layout_marginTop="@dimen/auth_create_primary_margin_top"
                    android:background="@drawable/bg_profile_button_primary"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/auth_submit_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/auth_create_account_action"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.21_28"
                        android:textColor="@color/profile_primary_button_label" />

                    <ProgressBar
                        android:id="@+id/auth_submit_progress"
                        android:layout_width="@dimen/auth_progress_size"
                        android:layout_height="@dimen/auth_progress_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/auth_progress_description"
                        android:indeterminateTint="@color/profile_primary_button_label"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/auth_have_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/auth_label_box"
                    android:layout_marginTop="@dimen/auth_have_account_margin_top"
                    android:gravity="center"
                    android:text="@string/auth_have_account"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
