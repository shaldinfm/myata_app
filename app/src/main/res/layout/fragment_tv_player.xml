<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true">

    <!--
        Full Screen Ambient Background

        Replaces the full-screen ImageView that held one flat palette colour. It
        is still match_parent and it is still the first child, so the frame it
        covers is exactly the frame it covered before: it draws the dark base and
        the animated field itself, and it takes part in no constraint. The cover
        is a separate view, above this and below the overlays, as it was.
    -->
    <com.example.musicplayerapp.ui.tv.TvAmbientBackgroundView
        android:id="@+id/view_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!--
        Global Dim Overlay

        Kept, but at 30% rather than the 40% it was: that scrim existed to tame a
        flat background made from the cover's most vibrant colour, and the ambient
        field is dark by construction (see TvAmbientPolicy). Measured on the TV AVD,
        at 40% the brightest part of the new field went from luma 39 - already
        nearly invisible - to 23, which is a black screen. At 30%, with the field at
        its brightest (luma 67), the composited background behind the title
        measures p99 20 of 255 against the 110 at which white text would drop below
        4.5:1. `TvAmbientBackgroundTest` is where those two numbers come from.
    -->
    <View
        android:id="@+id/view_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000" />

    <!-- Gradient Overlay (Scrim) -->
    <View
        android:id="@+id/view_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_scrim_bottom" />

    <!-- Back Button -->
    <!--
        19x19 focus target on a 1080p TV (38px at density 320) is far below the
        48dp minimum a D-pad needs, and the focused state only scales it 10%.
        The target is 48x48 with the padding carrying the whole 29dp difference,
        so the arrow itself is still drawn at its original 19x19 - the padding is
        what was made bigger, not the glyph.

        The padding is symmetric, which centres the arrow in the target, and the
        target is inset from the frame by tv_player_back_inset rather than pinned
        to the corner: it is the focus target that has to stay inside a TV's
        cropped edges, so it is the target that moves.
    -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/tv_player_back_inset"
        android:layout_marginTop="@dimen/tv_player_back_inset"
        android:padding="14.5dp"
        android:background="@null"
        android:stateListAnimator="@null"
        android:src="@drawable/btn_back_tv"
        android:scaleType="fitCenter"
        android:focusable="true"
        android:focusableInTouchMode="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Album Art -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_album_art"
        android:layout_width="@dimen/tv_player_artwork_size"
        android:layout_height="@dimen/tv_player_artwork_size"
        android:layout_marginBottom="@dimen/tv_player_artwork_gap"
        android:scaleType="centerCrop"
        android:src="@drawable/zaglushka_logo"
        app:shapeAppearanceOverlay="@style/RoundedCornerImage"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/tv_track_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.8" />

     <!-- Track Info (Artist - Title) -->
    <TextView
        android:id="@+id/tv_track_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="100dp"
        android:layout_marginEnd="100dp"
        android:fontFamily="@font/onest_regular"
        android:text="ARTIST - TRACK"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowDx="1.0"
        android:shadowDy="1.0"
        android:shadowRadius="6"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/container_play_pause" />

    <!-- Center Container for Play/Pause -->
    <FrameLayout
        android:id="@+id/container_play_pause"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_streams">

        <!--
            Material 3's circular icon-button proportions, recreated on the existing
            ImageButton: a 42dp tonal container with a 24dp glyph inside it (M3's own
            24-in-40 ratio), a white indicator ring for D-pad focus and a state layer
            for press. The old control was a solid white disc with the glyph cut out,
            with a 4dp elevation on top; both are gone, so it reads as part of the
            player instead of a hole in the artwork. Behaviour, size and focus
            semantics are untouched.
        -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tv_play_pause"
            android:src="@drawable/ic_tv_pause"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:focusable="true"
            android:focusableInTouchMode="false" />

        <ProgressBar
            android:id="@+id/loading_spinner"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Stream Selection Row -->
    <LinearLayout
        android:id="@+id/layout_streams"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tv_player_bottom_inset"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btn_stream_myata"
            android:layout_width="90dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_tv_stream_button_new"
            android:fontFamily="@font/onest_regular"
            android:gravity="center"
            android:text="MYATA"
            android:textColor="@color/tv_stream_button_label"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="false" />

        <Space
            android:layout_width="14dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btn_stream_gold"
            android:layout_width="90dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_tv_stream_button_new"
            android:fontFamily="@font/onest_regular"
            android:gravity="center"
            android:text="GOLD"
            android:textColor="@color/tv_stream_button_label"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="false" />

        <Space
            android:layout_width="14dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btn_stream_xtra"
            android:layout_width="90dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_tv_stream_button_new"
            android:fontFamily="@font/onest_regular"
            android:gravity="center"
            android:text="XTRA"
            android:textColor="@color/tv_stream_button_label"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="false" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
