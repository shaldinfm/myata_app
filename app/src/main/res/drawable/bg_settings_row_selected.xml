<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected appearance row, 2517:2818 / 2517:3785: same r12 `surface` plate as
  every other row, with the 1dp `outline` stroke replaced by a 2dp `primary` one.

  Two drawables rather than one with a state list: selection here is not a view
  state the framework tracks - it is which of three persisted values is current -
  so the fragment swaps the background, and the shape stays declarative.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/profile_row_container" />
    <stroke
        android:width="@dimen/settings_row_selected_stroke"
        android:color="@color/primary" />
    <corners android:radius="@dimen/profile_row_radius" />
</shape>
