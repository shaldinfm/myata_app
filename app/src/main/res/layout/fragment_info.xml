<?xml version="1.0" encoding="utf-8"?>
<!--
  ABOUT US - the frozen 3.6.6 canonical screen.

  Provenance: `ABOUT US` 2411:31594 on CURRENT ANDROID UI - LIGHT and
  `ABOUT US_dark` 2444:18567 on CURRENT ANDROID UI - DARK. The two are
  geometrically identical; everything that differs between them is a colour, and
  every colour here is a token that resolves per theme. There is no
  layout-night variant and there must not be one.

  Three owner-approved departures from the frozen frame, each of which would
  otherwise have added or removed behaviour:

    1. The header. Figma titles this screen "Поддержать радио"; the title here is
       "О нас", which is what the bottom bar calls the screen.
       The 40dp trailing button IS now drawn (G-A3): the FINAL Figma file places
       the profile control here as 2413:58 / 2444:18571, and it has a destination -
       profile-guest. The earlier note said it was omitted because it did nothing;
       that reason has expired rather than been overruled.
    2. Section 2. Figma draws paragraph 1 and hides the other two; the shipping
       screen has always shown all three. "Читать подробнее" expands them in
       place, so the collapsed default matches the design and no copy is lost.
    3. Section 3. Figma replaces the working Twitter link with Threads. Twitter
       is dropped and Threads takes its slot, per the owner.

  This file replaces the old layout-sw320dp variant as well. That qualifier
  matches every device at or above 320dp - i.e. all of them - so the variant was
  the copy that actually inflated, and keeping a second divergent one would mean
  the frozen composition shipped nowhere. One responsive layout instead.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/about_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <!--
          `Header - TopAppBar` 2413:55 / 2444:18568: 64 tall, 16 horizontal
          padding, title centred vertically.

          A FIXED 64dp band below the status bar inset, which `about_root`
          carries - the same shape HOME (`main_content_container` +
          `home_greeting`) and COLLECTION (`collection_root` + its title) already
          use, so all three titles land on one baseline. Applying the inset to
          this view instead, as ABOUT used to, eats it out of the band's own 64
          and lifts the title ~12dp above the other sections.

          Keeps the id `title`: the split-mode observer hides this view.
        -->
        <LinearLayout
            android:id="@+id/about_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/about_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/about_content_margin_horizontal"
            android:paddingEnd="@dimen/about_content_margin_horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/about_title"
                android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                android:textColor="@color/text_heading" />

            <include
                android:id="@+id/profile_entry"
                layout="@layout/view_profile_entry" />
        </LinearLayout>

        <!--
          `Main` 2411:31630. The frozen frame is 1418 tall against a 757 viewport,
          so this screen has always scrolled; the frame's own 100dp bottom padding
          is replaced by content_bottom_clearance, the shared band every screen
          the Mini Player floats over reserves.
        -->
        <ScrollView
            android:id="@+id/about_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/content_bottom_clearance"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/about_content_margin_horizontal"
                android:paddingTop="@dimen/about_content_padding_top"
                android:paddingEnd="@dimen/about_content_margin_horizontal"
                android:paddingBottom="@dimen/about_content_padding_bottom">

                <!-- ============ Section 1: Support the Project (2411:31631) ============

                     Its "Помочь проекту" heading 2411:31632 is visible:false on
                     both canonical pages and is not drawn. -->

                <!-- `Boosty Subscription Card` 2411:31635, 358x286 r24. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_about_card_boosty"
                    android:orientation="vertical"
                    android:padding="@dimen/about_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_about_chip_boosty"
                        android:paddingStart="@dimen/about_chip_padding_horizontal"
                        android:paddingTop="@dimen/about_chip_padding_vertical"
                        android:paddingEnd="@dimen/about_chip_padding_horizontal"
                        android:paddingBottom="@dimen/about_chip_padding_vertical"
                        android:text="@string/about_boosty_badge"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.12_16"
                        android:textColor="@color/about_boosty_chip_label" />

                    <!-- 8 itemSpacing + 8 wrapper paddingTop = 16. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_card_spacing"
                        android:text="@string/about_boosty_heading"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                        android:textColor="@color/brand_about_boosty_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_card_item_spacing"
                        android:text="@string/about_boosty_body"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                        android:textColor="@color/brand_about_boosty_content" />

                    <!-- `Button` 2411:31645, 200x52 r12, hug width. -->
                    <TextView
                        android:id="@+id/boosty_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/about_button_height"
                        android:layout_marginTop="@dimen/about_card_button_spacing"
                        android:background="@drawable/bg_about_boosty_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/about_button_padding_horizontal"
                        android:paddingEnd="@dimen/about_button_padding_horizontal"
                        android:text="@string/about_boosty_cta"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.22_28"
                        android:textColor="@color/brand_donate_cta_content" />
                </LinearLayout>

                <!-- `One-time Donation Card` 2411:31649, 358x266 r24. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_card_spacing"
                    android:background="@drawable/bg_about_card_onetime"
                    android:orientation="vertical"
                    android:padding="@dimen/about_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_about_chip_onetime"
                        android:paddingStart="@dimen/about_chip_padding_horizontal"
                        android:paddingTop="@dimen/about_chip_padding_vertical"
                        android:paddingEnd="@dimen/about_chip_padding_horizontal"
                        android:paddingBottom="@dimen/about_chip_padding_vertical"
                        android:text="@string/about_onetime_badge"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.12_16"
                        android:textColor="@color/about_onetime_chip_label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_card_spacing"
                        android:text="@string/about_onetime_heading"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                        android:textColor="@color/about_onetime_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_card_item_spacing"
                        android:text="@string/about_onetime_body"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                        android:textColor="@color/about_onetime_content" />

                    <!--
                      `Button` 2411:31659, 260x52 r12. This is the app's existing
                      donation entry point - same id, same label, same fixed brand
                      colours it already had - now inside the card the frozen
                      design puts it in. It opens YooMoney directly; the amount is
                      typed there rather than on a screen of ours.
                    -->
                    <TextView
                        android:id="@+id/donate_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/about_button_height"
                        android:layout_marginTop="@dimen/about_card_button_spacing"
                        android:background="@drawable/bg_donate_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/about_button_padding_horizontal"
                        android:paddingEnd="@dimen/about_button_padding_horizontal"
                        android:text="@string/about_donate_cta"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.22_28"
                        android:textColor="@color/brand_donate_cta_content" />
                </LinearLayout>

                <!-- ============ Section 2: About Us (2411:31663) ============ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_section_spacing"
                    android:background="@drawable/bg_about_section_card"
                    android:orientation="vertical"
                    android:padding="@dimen/about_section_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_heading"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Bold.28_36"
                        android:textColor="@color/text_heading" />

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_card_spacing"
                        android:text="@string/about_paragraph_1"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_24"
                        android:textColor="@color/text_secondary" />

                    <!--
                      2411:31671 and 2411:31673, both visible:false in Figma.
                      Collapsed here to match, and expanded by `read_more`.
                      GOLD and XTRA inside the third one keep the Onest Black
                      emphasis InfoFragment has always applied.
                    -->
                    <TextView
                        android:id="@+id/description_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_paragraph_spacing"
                        android:text="@string/about_paragraph_2"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_24"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/description_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_paragraph_spacing"
                        android:text="@string/about_paragraph_3"
                        android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_24"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                    <!-- `Button` 2424:758: fills the card, r12, 12dp vertical padding. -->
                    <TextView
                        android:id="@+id/read_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_read_more_gap"
                        android:background="@drawable/bg_about_read_more"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="@dimen/about_read_more_padding_vertical"
                        android:paddingBottom="@dimen/about_read_more_padding_vertical"
                        android:text="@string/about_read_more"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.22_28"
                        android:textColor="@color/text_heading" />
                </LinearLayout>

                <!-- ============ Section 3: Social Media (2411:31674) ============ -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_section_spacing"
                    android:text="@string/about_social_heading"
                    android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                    android:textColor="@color/text_heading" />

                <!--
                  4x76 tiles with 18dp gaps come to exactly 358 - the content
                  width at 390dp - so the tiles are square by ratio and sized by
                  the chain rather than pinned to 76dp. At 390 that reproduces the
                  frozen tile on the nose; below it they shrink together and the
                  glyph shrinks with them, instead of the row overflowing.

                  The glyphs are the owner-supplied FINAL assets, reconstructed
                  from the local `Дизайн Приложения ФИНАЛ.fig` fillGeometry command
                  blobs and instance overrides for `Section 3: Social Media`
                  2411:31674 (light) / 2444:18620 (dark). Nothing here is an icon
                  pack, a web logo or a redraw - two earlier attempts at those were
                  rejected, correctly.

                  **They are 76x76, not 48x48, and that is the whole integration.**
                  Each asset is a transparent tile-sized drawable that already
                  carries the glyph at its exact FINAL offset inside the tile - the
                  Telegram disc sits at translate(15,14), YouTube's body at
                  (15.05,21.09), and so on. So the tile gives them NO padding: the
                  76 viewport maps straight onto the 76dp tile and the glyph lands
                  where the design puts it. Adding the old 14dp padding back would
                  inset an already-inset glyph and shrink it twice.

                  Fills are baked in per theme and must not be tinted. Light and
                  dark differ by more than one colour - Telegram and YouTube are
                  two-tone and swap which fill is the knockout - so a single tint
                  cannot express them, which is why the retired
                  `about_social_icon` token is gone rather than reused. Theme
                  selection is plain resource qualification: drawable/ is light,
                  drawable-night/ is dark, same filename.
                -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_social_heading_gap">

                    <ImageView
                        android:id="@+id/telegram"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_telegram"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_telegram"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toStartOf="@id/spotify"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/spotify"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/about_social_tile_gap_horizontal"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_spotify"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_spotify"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toStartOf="@id/instagram"
                        app:layout_constraintStart_toEndOf="@id/telegram"
                        app:layout_constraintTop_toTopOf="@id/telegram" />

                    <ImageView
                        android:id="@+id/instagram"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/about_social_tile_gap_horizontal"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_instagram"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_instagram"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toStartOf="@id/tiktok"
                        app:layout_constraintStart_toEndOf="@id/spotify"
                        app:layout_constraintTop_toTopOf="@id/telegram" />

                    <ImageView
                        android:id="@+id/tiktok"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/about_social_tile_gap_horizontal"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_tiktok"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_tiktok"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/instagram"
                        app:layout_constraintTop_toTopOf="@id/telegram" />

                    <ImageView
                        android:id="@+id/youtube"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/about_social_tile_gap_vertical"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_youtube"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_youtube"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="@id/telegram"
                        app:layout_constraintStart_toStartOf="@id/telegram"
                        app:layout_constraintTop_toBottomOf="@id/telegram" />

                    <ImageView
                        android:id="@+id/threads"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/about_social_tile_gap_vertical"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_threads"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_threads"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="@id/spotify"
                        app:layout_constraintStart_toStartOf="@id/spotify"
                        app:layout_constraintTop_toBottomOf="@id/telegram" />

                    <ImageView
                        android:id="@+id/boosty"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/about_social_tile_gap_vertical"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_boosty"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_boosty"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="@id/instagram"
                        app:layout_constraintStart_toStartOf="@id/instagram"
                        app:layout_constraintTop_toBottomOf="@id/telegram" />

                    <ImageView
                        android:id="@+id/yandex"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/about_social_tile_gap_vertical"
                        android:background="@drawable/bg_about_social_tile"
                        android:contentDescription="@string/about_social_yandex"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_about_yandex_music"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="@id/tiktok"
                        app:layout_constraintStart_toStartOf="@id/tiktok"
                        app:layout_constraintTop_toBottomOf="@id/telegram" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
