    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M23.6593 17.7549L15.0502 26.364L13.636 24.9497L22.2451 16.3407L14.3255 16.3407L14.3431 14.3431H25.6568V25.6569L23.6593 25.6745L23.6593 17.7549Z" />
</vector>
