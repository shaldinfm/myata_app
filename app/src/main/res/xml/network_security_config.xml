<?xml version="1.0" encoding="utf-8"?>
<!--
    Full TLS validation for the whole app.

    Everything defaults to the system trust store over HTTPS. Two of our own hosts
    additionally get a bundled root, because their chains end at CAs that older
    Android system stores do not carry:

      radiomyata.ru         -> ISRG Root X1            (system store: Android 7.1.1+)
      radio.dline-media.com -> GlobalSign Root R46     (system store: Android 14+)
                               GlobalSign Root CA - R6 (system store: recent Android only)

    The stream certificate was reissued on 2026-09-15 under GlobalSign Root R46.
    R6 stays bundled so a chain that goes back to it keeps working too.

    These are extra trust anchors, not pins: "system" stays listed alongside them,
    so an ordinary server-certificate rotation under any trusted CA keeps working.
    Chain building and hostname verification are unchanged. Scoped per domain so
    the extra anchors never widen trust for third-party hosts.

    Applies from API 24. See SecureNetModule for what this replaced.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Metadata API, track history and playlist covers. -->
    <domain-config>
        <domain includeSubdomains="true">radiomyata.ru</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>

    <!--
        Audio streams. MediaPlayerService keeps a plain-HTTP fallback for legacy
        TV/projector devices whose TLS stack cannot complete the handshake at all,
        so cleartext is permitted here and nowhere else.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">radio.dline-media.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_root_r46" />
            <certificates src="@raw/globalsign_root_r6" />
        </trust-anchors>
    </domain-config>

    <!--
        Stream nodes. radio.dline-media.com answers every stream with a redirect to
        a node host (drh-node-03.dline-media.com at the time of writing), and the
        node needs the same anchors or older devices fail the handshake after the
        redirect. Node names are the provider's to change, so the whole domain is
        covered rather than one host.

        HTTPS only. The platform applies the most specific matching domain rule, so
        radio.dline-media.com keeps the block above and its cleartext permission
        reaches no other host.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">dline-media.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_root_r46" />
            <certificates src="@raw/globalsign_root_r6" />
        </trust-anchors>
    </domain-config>

</network-security-config>
