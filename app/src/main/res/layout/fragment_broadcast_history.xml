<?xml version="1.0" encoding="utf-8"?>
<!--
  История эфира, full screen (G4b). One destination, four frozen frames:

      history-loading   2517:2420 / 2517:3387   eight static skeleton rows
      history-content   2523:23   / 2517:3296   the list, one circular action per row
      history-empty     2517:2509 / 2517:3476   "Пока нет истории" + outlined Обновить
      history-error     2517:2547 / 2517:3514   "Не удалось загрузить" + filled Повторить

  Which one shows is HistoryScreenState's decision; this file only draws them.

  **The band** is `Header - TopAppBar` with back, 390x64 - the settings, profile and
  report band down to the dimens, so it reuses theirs: back 24 at x=12, the title
  at x=56 in Montserrat Medium 24/32 on `text_heading`.

  **The list** is `Broadcast History List`: 16 in from both sides, 16 down from the
  band, rows 8 apart, then the footer, then the screen's own 24 of bottom padding
  (plus the navigation bar's inset - there is no bottom bar over this screen, so
  nothing else reserves it).

  **The two message frames** share one geometry, measured from the band's bottom:
  a 96 circle at 104, the headline 32 under it, the body 12 under that, the button
  28 under the body. Anchored to the top as the frames are, not centred in
  whatever height the device has.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".fragments.BroadcastHistoryFragment">

    <LinearLayout
        android:id="@+id/history_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/profile_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/profile_back_margin_start"
        android:paddingEnd="@dimen/profile_margin">

        <ImageView
            android:id="@+id/history_back"
            android:layout_width="@dimen/profile_back_size"
            android:layout_height="@dimen/profile_back_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_back_description"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_back" />

        <TextView
            android:id="@+id/history_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profile_title_margin_start"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/player_history"
            android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
            android:textColor="@color/text_heading" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================ CONTENT ============================ -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/history_screen_margin"
            android:paddingTop="@dimen/history_screen_list_top"
            android:paddingEnd="@dimen/history_screen_margin"
            android:paddingBottom="@dimen/history_screen_list_bottom"
            android:scrollbars="none"
            android:visibility="gone"
            tools:listitem="@layout/item_broadcast_history_track"
            tools:visibility="visible" />

        <!-- ============================ LOADING ============================ -->

        <!--
          Eight rows, as the frame draws. Static and not scrollable - rows past the
          bottom of a short window are simply cut off, which is what a placeholder
          for a list longer than the window should look like. Hidden from
          accessibility: there is nothing in it to read.
        -->
        <LinearLayout
            android:id="@+id/history_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/history_screen_margin"
            android:paddingTop="@dimen/history_screen_list_top"
            android:paddingEnd="@dimen/history_screen_margin"
            android:visibility="gone">

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />

            <include
                layout="@layout/item_broadcast_history_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_skeleton_row_height"
                android:layout_marginTop="@dimen/history_screen_row_gap" />
        </LinearLayout>

        <!-- ============================= EMPTY ============================= -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/history_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/history_screen_margin"
                android:paddingEnd="@dimen/history_screen_margin">

                <!-- `Illustration` 96 r48 holding `Icon / doc` on `primary`. -->
                <FrameLayout
                    android:id="@+id/history_empty_illustration"
                    android:layout_width="@dimen/history_state_illustration_size"
                    android:layout_height="@dimen/history_state_illustration_size"
                    android:layout_marginTop="@dimen/history_state_illustration_top"
                    android:background="@drawable/bg_history_state_illustration">

                    <ImageView
                        android:layout_width="@dimen/history_state_icon_size"
                        android:layout_height="@dimen/history_state_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_menu_doc"
                        app:tint="@color/primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/history_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/history_state_headline_gap"
                    android:gravity="center_horizontal"
                    android:minHeight="@dimen/history_state_headline_min_height"
                    android:text="@string/history_empty_title"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.24_32"
                    android:textColor="@color/text_heading" />

                <TextView
                    android:id="@+id/history_empty_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/history_state_body_gap"
                    android:gravity="center_horizontal"
                    android:text="@string/history_empty_body"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_secondary" />

                <!-- `Button` outline: surface fill, 1px `outline`, `text_heading` label. -->
                <TextView
                    android:id="@+id/history_empty_action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_button_height"
                    android:layout_marginTop="@dimen/history_state_button_gap"
                    android:background="@drawable/bg_profile_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/history_empty_action"
                    android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.21_28"
                    android:textColor="@color/text_heading" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============================= ERROR ============================= -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/history_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/history_screen_margin"
                android:paddingEnd="@dimen/history_screen_margin">

                <!--
                  `Icon / alert` on `error` (#B3261E / #FF8A80) - the menu's alert
                  glyph, measured to the same stroke geometry in the file.
                -->
                <FrameLayout
                    android:id="@+id/history_error_illustration"
                    android:layout_width="@dimen/history_state_illustration_size"
                    android:layout_height="@dimen/history_state_illustration_size"
                    android:layout_marginTop="@dimen/history_state_illustration_top"
                    android:background="@drawable/bg_history_state_illustration">

                    <ImageView
                        android:layout_width="@dimen/history_state_icon_size"
                        android:layout_height="@dimen/history_state_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_player_overflow_alert"
                        app:tint="@color/error" />
                </FrameLayout>

                <TextView
                    android:id="@+id/history_error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/history_state_headline_gap"
                    android:gravity="center_horizontal"
                    android:minHeight="@dimen/history_state_headline_min_height"
                    android:text="@string/history_error_title"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.24_32"
                    android:textColor="@color/text_heading" />

                <TextView
                    android:id="@+id/history_error_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/history_state_body_gap"
                    android:gravity="center_horizontal"
                    android:text="@string/history_error_body"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.15_22"
                    android:textColor="@color/text_secondary" />

                <!-- `Button` primary: `primary` fill, `on_primary`-role label. -->
                <TextView
                    android:id="@+id/history_error_action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_button_height"
                    android:layout_marginTop="@dimen/history_state_button_gap"
                    android:background="@drawable/bg_profile_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/history_error_action"
                    android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.21_28"
                    android:textColor="@color/profile_primary_button_label" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
