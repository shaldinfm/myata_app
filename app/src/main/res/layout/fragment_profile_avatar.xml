<?xml version="1.0" encoding="utf-8"?>
<!--
  profile-avatar 2523:137 (light) / 2517:3678 (dark), 390x702 (G6a).

  Geometry is in dimens.xml under `profile-avatar`. The band is profile-authenticated's,
  unchanged. The 24 cells (4 across, 6 down) are built by ProfileAvatarFragment from
  ProfileAvatars, so the order lives in one list rather than in 24 copies of a cell here.
  The frame drew 4x4; the approved set is 24, so the grid grows downwards with the same
  76dp cells and 18dp gutters and the screen scrolls to `Сохранить`.

  ## `Текущий аватар` with nothing chosen

  The frame only draws the preview holding an avatar. An account that has never chosen
  one shows what its profile card shows - the initial on `primary` - at this size, so
  the preview never claims an avatar the listener does not have.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/avatar_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        tools:context=".fragments.ProfileAvatarFragment">

        <LinearLayout
            android:id="@+id/avatar_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/profile_back_margin_start"
            android:paddingEnd="@dimen/profile_margin">

            <ImageView
                android:id="@+id/avatar_back"
                android:layout_width="@dimen/profile_back_size"
                android:layout_height="@dimen/profile_back_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_back_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:id="@+id/avatar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/profile_title_margin_start"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/avatar_title"
                android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                android:textColor="@color/text_heading" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/avatar_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/avatar_scroll_bottom_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/profile_margin"
                android:paddingEnd="@dimen/profile_margin">

                <!-- `Current` 2523:144: 96x96, r48, image fill, 2dp inside ring. -->
                <FrameLayout
                    android:id="@+id/avatar_current"
                    android:layout_width="@dimen/avatar_current_size"
                    android:layout_height="@dimen/avatar_current_size"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/avatar_current_margin_top"
                    android:focusable="true"
                    android:foreground="@drawable/bg_avatar_cell_ring_selected"
                    android:importantForAccessibility="yes">

                    <!-- The disc and the letter are separate for the reason the profile
                         card's are: AvatarInitial translates the letter, not the circle. -->
                    <View
                        android:id="@+id/avatar_current_disc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_profile_avatar_account"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/avatar_current_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/onest_medium"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/on_primary"
                        android:textSize="36sp"
                        tools:text="Д" />

                    <ImageView
                        android:id="@+id/avatar_current_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/avatar_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/avatar_caption_margin_top"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:minHeight="@dimen/auth_label_box"
                    android:text="@string/avatar_current_caption"
                    android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                    android:textColor="@color/text_secondary" />

                <com.example.musicplayerapp.ui.profile.AvatarGridLayout
                    android:id="@+id/avatar_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/avatar_grid_margin_top" />

                <!-- `Button` 2523:165: 358x52, r12, `primary`; label Montserrat Medium 21/28. -->
                <TextView
                    android:id="@+id/avatar_save"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_button_height"
                    android:layout_marginTop="@dimen/avatar_save_margin_top"
                    android:background="@drawable/bg_profile_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/avatar_save"
                    android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.21_28"
                    android:textColor="@color/avatar_on_primary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
