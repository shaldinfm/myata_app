<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PLAYER shell, migrated to the frozen 3.6.6 canonical design (Phase B).

      Source: the canonical `PLAYER` / `PLAYER_dark` frames. The screen is a flat
      `background` fill - the frozen design has no full-bleed stream artwork behind
      the player, only the album art and its backdrop.

      This file owns the chrome that does not swipe. `Mobile Header (Subtle)` says
      "Сейчас играет" on every stream and the swipe dots describe the pager itself,
      so both stay still while the pages move underneath; the per-stream content
      lives in fragment_myata_stream.xml and starts at the frozen 79.

        16   header row top      63   header row bottom / swipe top
        73   swipe bottom        79   page top
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!--
          Header row, 358x47 at 16. The label is centred because both ends reserve
          a slot: the frozen leading Button is hidden, and the trailing overflow
          occupies the other - see player_header_action.
        -->
        <FrameLayout
            android:id="@+id/player_header"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_header_height"
            android:layout_marginStart="@dimen/player_margin"
            android:layout_marginTop="@dimen/player_margin"
            android:layout_marginEnd="@dimen/player_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!--
              The frozen label is `textCase: UPPER` with 0.6px of tracking at 12,
              so it reads "СЕЙЧАС ИГРАЕТ". The string keeps the source characters
              the design stores and textAllCaps does what Figma's case does;
              0.6/12 is the 0.05em below.
            -->
            <TextView
                android:id="@+id/player_header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:text="@string/player_now_playing"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.12_16"
                android:textColor="@color/player_header_label" />

            <!--
              The frozen overflow control, `Button:margin` 32.02x39 @325.98,4.

              It was a reserved, empty `Space` until G1a: the canonical menu is
              four rows all reading "Действие", and its real entries - Sleep Timer
              (D), Report a problem (E) - are still later phases, so drawing a
              control would have been a button that does nothing. It has one real
              action now, `Настройки`, so the box it was holding open becomes the
              control the frozen design draws in it.

              ## The glyph, and why it is the Collection's file

              Both headers draw the identical frozen node - `Button` 20x39 holding
              a `Container` 4x16 dot column - and `player_header_label` and
              `collection_header_action` carry the *same* pair of values in both
              themes (#42474E / #F5F7FA). One authored glyph, therefore, rather
              than a byte-identical second copy. The tint is named for the surface
              it is on, which is what keeps that a coincidence this file relies on
              rather than one it hides: if the Player's label token ever moves, this
              moves with it.

              ## Why the padding

              `Button:margin` is 32 wide but the `Button` inside it is 20, anchored
              to its start, and the dots are centred in *that*: absolute x=333.98,
              20.02 from the header's trailing edge, not 14. paddingEnd narrows the
              content box to the leading 20 so `center` lands the column where the
              frame puts it. The outer box stays 32, so the label stays centred
              exactly where it was.
            -->
            <ImageView
                android:id="@+id/player_header_action"
                android:layout_width="@dimen/player_header_action_width"
                android:layout_height="@dimen/player_header_action_height"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_overflow"
                android:paddingEnd="@dimen/player_header_action_inset"
                android:scaleType="center"
                android:src="@drawable/ic_collection_overflow"
                app:tint="@color/player_header_label" />
        </FrameLayout>

        <!--
          `swipe`: which of MYATA / GOLD / XTRA is showing.

          Three 10x10 slots edge to edge - the frozen row has itemSpacing 0 - each
          holding a marker about 8.4 across, centred. The active page is a
          nine-lobed cookie at full `primary`; the other two are plain circles in
          the declared inactive pair. `scaleType=center` draws each marker at its
          own intrinsic size, so the 10 slot stays the frozen slot and the shape
          inside it stays the frozen shape.

          `isSelected` drives the tint through player_swipe_tint; PlayerFragment
          sets it together with the drawable.
        -->
        <LinearLayout
            android:id="@+id/dots_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_header">

            <ImageView
                android:id="@+id/dot_1"
                style="@style/PlayerSwipeDot"
                android:src="@drawable/ic_player_swipe_active" />

            <ImageView
                android:id="@+id/dot_2"
                style="@style/PlayerSwipeDot"
                android:src="@drawable/ic_player_swipe_inactive" />

            <ImageView
                android:id="@+id/dot_3"
                style="@style/PlayerSwipeDot"
                android:src="@drawable/ic_player_swipe_inactive" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/player_page_gap"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dots_indicator"
            tools:layout_height="600dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
