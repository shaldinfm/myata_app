    <!--
      Bottom navigation, frozen 3.6.6 canonical metrics.

      Item 46dp tall to match the active pill; icon 20x20 at the top of the item;
      label Muller Medium 12sp on a 16sp line, which is the canonical nav label
      style. Inactive content is the text_secondary semantic role, so it resolves
      #42474E in Light and #B3C4D1 in Dark. Active content is the fixed brand
      colour and is applied at runtime with the pill.
    -->
    <style name="BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BottomNavIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!--
      The nav label is the first surface on the 3.6.6 typography, and the one the
      mechanism is proven on: family, weight, size and line height now all come
      from a single token instead of being spelled out here.

      Medium 12 on a 16sp line is unchanged - it is what this style already said,
      and what the frozen contract says. Only the family moves, from Muller Medium
      to Onest Medium, which the replacement audit measured as the closest of the
      candidates on exactly this string: `Коллекция` gains margin at 320dp rather
      than losing it.

      android:textAppearance, not the attributes directly, because that is what
      MyataTypography.Factory looks for. It resolves through this style just as it
      would from a view, and the factory then adds the two halves a text
      appearance cannot carry - the line height, which the framework only reads
      from an appearance at API 28, and includeFontPadding, which is not an
      appearance attribute at all. lineSpacingExtra is gone with it: the token's
      line height replaces it outright, and leaving both would compound them.
    -->
    <style name="BottomNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Myata.Onest.Medium.12_16</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
      Mini Player artwork corner, frozen 3.6.6 canonical: the 48x48 `Container`
      inside the pill has cornerRadius 8 and clips its image fill.

      B2 expected the Broadcast History row to reuse this and left the name
      general for that reason. The frozen section says otherwise: its thumbnail is
      40x40 at r6 (`History Item N > Container > Background`, light 2396:30798),
      not 48x48 at r8, so Phase C declares its own shape below instead of bending
      this one. Only the mini player uses this now.
    -->
    <style name="ShapeAppearance.Myata.Artwork48" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/mini_player_artwork_corner</item>
    </style>

    <!--
      Broadcast History row artwork corner: the frozen 40x40 plate is r6 and its
      `Album Art` child clips an IMAGE fill set to CROP.
    -->
    <style name="ShapeAppearance.Myata.PlayerHistoryArtwork" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/player_history_artwork_corner</item>
    </style>

    <!--
      HOME stream card, frozen 3.6.6 canonical: `плашка потока MYATA` and
      `... GOLD`, 316x198 with corner radius 14.

      The frozen card carries two stacked shadows - the row's own r6 at y2, and
      each card's r10 at y11 - which Android expresses as one elevation. 8dp is
      the closest single value to the dominant one.
    -->
    <style name="HomeStreamCard">
        <item name="android:layout_width">@dimen/home_stream_card_width</item>
        <item name="android:layout_height">@dimen/home_stream_card_height</item>
        <item name="cardCornerRadius">@dimen/home_stream_card_corner</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeStreamCardImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">fitXY</item>
    </style>

    <!--
      HOME playlist card, frozen 3.6.6 canonical: `Playlist N > Background`,
      160x160 with corner radius 20 and a cropped image fill. The card clips the
      artwork, so the adapter loads a plain bitmap - rounding it a second time in
      Picasso, at a different radius, is what used to fight this.
    -->
    <style name="HomePlaylistCard">
        <item name="android:layout_width">@dimen/home_playlist_card_size</item>
        <item name="android:layout_height">@dimen/home_playlist_card_size</item>
        <item name="cardCornerRadius">@dimen/home_playlist_card_corner</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/brand_playlist_card_placeholder</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!--
      PLAYER album art, frozen 3.6.6 canonical: `Album Art (Organic Shape) >
      Current Track Artwork`, 239x239 at radius 20 with a 1px stroke and an image
      fill set to FILL. The stroke is the `outline` role: #466D8F in dark is
      exactly that role's dark value, and light's #FFFFFF is a near neighbour of
      its #E1E3E4 - one role, so one token rather than a new pair.
    -->
    <style name="PlayerArtworkCard">
        <item name="android:layout_width">@dimen/player_artwork_size</item>
        <item name="android:layout_height">@dimen/player_artwork_size</item>
        <item name="cardCornerRadius">@dimen/player_artwork_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/brand_player_artwork_backdrop</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/player_artwork_stroke</item>
    </style>

    <!--
      PLAYER secondary control, frozen canonical `like` / `dislike`: a 49x54
      borderless slot holding a 25x23 icon.

      Phase B ships the existing favourite and History access in these two slots.
      No dislike control is added: the frozen `dislike` has no counterpart in the
      app today, and History has nowhere else to go until Phase C brings the
      Broadcast History card onto this screen.
    -->
    <!--
      PLAYER swipe marker, frozen canonical `swipe > Shape Set`: a 10x10 slot with
      an ~8.4 shape centred in it. `center` rather than `fitCenter` so the shape
      keeps its own size instead of filling the slot, and the tint is a selector
      on `state_selected`.
    -->
    <style name="PlayerSwipeDot">
        <item name="android:layout_width">@dimen/player_swipe_size</item>
        <item name="android:layout_height">@dimen/player_swipe_size</item>
        <item name="android:scaleType">center</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/player_swipe_tint</item>
    </style>

    <!--
      PLAYER `like` and `dislike`, frozen canonical: a 49x54 slot whose glyph is
      placed rather than centred - 24.5x23.33 with 12 above it and 19 below,
      which puts it 3.5 higher than the middle of the row. `center` keeps the
      drawable at its own 24.5x23.33.

      Both side slots share it. The frozen frame reads them identically
      (`like`/`dislike > Container > Icon`, 24.5x23.33), and they only had
      different styles while the trailing one was standing in for the History
      entry, which fitCenter'd a 24dp glyph instead. Their colours still differ,
      and those stay on the views: `player_like` and `player_control_action`.
    -->
    <style name="PlayerLikeSlot">
        <item name="android:layout_width">@dimen/player_action_width</item>
        <item name="android:layout_height">@dimen/player_action_height</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:paddingStart">@dimen/player_action_icon_inset</item>
        <item name="android:paddingEnd">@dimen/player_action_icon_inset</item>
        <item name="android:paddingTop">@dimen/player_action_icon_inset</item>
        <item name="android:paddingBottom">@dimen/player_action_icon_inset_bottom</item>
    </style>

    <!--
      PLAYER Broadcast History section, frozen 3.6.6 canonical (Phase C).

      `Broadcast History Section` - light node 2396:30784, dark 2444:18288:
      358 wide, r20, on `surface` with a 1px INSIDE stroke on `outline`. Both
      colours are exact matches to those roles on both canonical pages, so the
      card needs no colour of its own.

      Elevation 0. The frozen node does carry a DROP_SHADOW, but it is
      `visible: false` - authored and switched off - so drawing one would be
      reproducing a disabled property.
    -->
    <style name="PlayerHistoryCard">
        <item name="android:layout_width">match_parent</item>
        <item name="cardCornerRadius">@dimen/player_history_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/player_history_stroke</item>
    </style>

    <!--
      COLLECTION card, frozen 3.6.6 canonical.

      One style for both surfaces the screen draws, because the frozen design
      draws them the same: `Track Item N` on `COLLECTION` and the single 358x359
      empty card on `COLLECTION pusto` are both r24 on `surface` with a 1px
      INSIDE stroke on `outline`. Every one of those four values is an exact
      match to a semantic role on both canonical pages, so this needs no new
      colour of its own.

      Elevation 0: the frozen cards carry no shadow. The rounding is the whole
      of their separation from the background.
    -->
    <style name="CollectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="cardCornerRadius">@dimen/collection_card_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/collection_card_stroke</item>
    </style>

    <style name="RoundedCornerImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!--
      COLLECTION track row cover, frozen `Track Item N > Container`: 64x64, r20.
    -->
    <style name="ShapeAppearance.Myata.CollectionRowArtwork" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/collection_row_artwork_corner</item>
    </style>

    <!--
      The per-track sheet, FINAL `Bottom Sheet / Действия с треком` (F1).

      The row is the frozen `Sheet row / …`: 56 tall, 16 padding either side, a
      48x48 icon slot holding a 24 glyph, then 12, then the label at 76. Pitch is
      58, so the 2dp margin here is the gap between rows; the first row and the
      destructive row override it with the gaps their own anchors need.

      Rows are `selectableItemBackground` rather than a drawn press state: the
      frozen sheet specifies no pressed fill, and the platform ripple is what
      every other list surface in the app uses.
    -->
    <style name="CollectionSheetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/sheet_row_height</item>
        <item name="android:layout_marginTop">@dimen/sheet_row_gap</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <!--
          Start/end rather than paddingHorizontal: AAPT expands the shorthand in
          a layout, but in a style it is a plain API 26 attribute and minSdk is 24.
        -->
        <item name="android:paddingStart">@dimen/sheet_row_icon_inset</item>
        <item name="android:paddingEnd">@dimen/sheet_row_icon_inset</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CollectionSheetRowIcon">
        <item name="android:layout_width">@dimen/sheet_row_icon_slot</item>
        <item name="android:layout_height">@dimen/sheet_row_icon_slot</item>
        <item name="android:scaleType">center</item>
    </style>

    <!--
      Label at x=76 on a 358 row: 16 padding + the 48 slot + the frozen 12 gap.
    -->
    <style name="CollectionSheetRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Myata.Onest.Medium.16_22</item>
    </style>

    <!--
      The sheet floats on the screen's own 16 margins with r28 on all four
      corners, so the Material sheet background is cleared to transparent and the
      card in sheet_collection_track.xml draws the whole surface itself.
    -->
    <style name="Theme.Myata.CollectionTrackSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Myata.CollectionTrackSheet</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="Widget.Myata.CollectionTrackSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <!-- BottomSheet style for History dialog -->
    <style name="Theme.MusicPlayerApp.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>