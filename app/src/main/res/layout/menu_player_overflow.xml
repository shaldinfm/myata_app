<?xml version="1.0" encoding="utf-8"?>
<!--
  PLAYER overflow menu. All four frozen rows as of G4b.

  Source: canonical `Menu / Плеер` 2444:18763 (206x264, r20, `menuSurface` on a
  1px `menuOutline`), widened to 260 by the frozen proposal
  `sleep-timer-menu-active` 2517:2093 whose note is explicit - "The canonical menu
  is 206 wide, which cannot hold a label plus a trailing value. Widened to 260.
  This is the only change proposed to the existing menu."

  ## The frozen four, in the frozen order

      1  Найти трек            G4b   opens FindTrackSheet for the current track
      2  Таймер сна            G2    opens SleepTimerSheet
      3  Сообщить о проблеме   G3    pushes report_problem
      4  История эфира         G4b   pushes broadcast_history

  G2 and G3 shipped rows 2 and 3 with 1 and 4 absent rather than inert, because
  there was nothing behind them. G4b builds what was behind them, so the menu is
  the whole frozen menu now and nothing is missing from it.

  ## Geometry - the compact row, by owner override (G4a review)

  The frozen primitive (screens-3.6.6/spec/primitives.mjs:184) puts a 48 icon
  slot at x=12 in each row, the label at x=70, and 50 of padding under the last
  row. Rendered, that measured identical to the file within 0.76dp - and the
  owner rejected it on the rendered surface: the icon sat 38dp in from the card
  edge and the menu carried a 50dp empty band. This is an explicit override of
  the frozen frame, applied identically to this menu and to `Menu / Коллекция`:

      menu            260 wide, r20, 1px outline, no shadow   (unchanged)
      padding         10 top, 10 bottom                        (was 10 / 50)
      row             238x48 at x=11, pitch 52                 (unchanged)
      content         16 from the card edge on both sides      (row pad 5 + 11)
      icon            24x24 box at card-x 16                   (was a 48 slot at 23)
      label           card-x 56, 16 after the icon             (was 81)
      trailing        right-aligned, ending 16 from the card   (was 11)

  **The height is not a number of its own.** Every row is the same
  `player_overflow_row_height`, every row after the first carries the same
  `player_overflow_row_gap` above it, and the card carries the same 10 / 10. So
  the menu is wrap_content and its height is whatever those give:

      4 rows   10 + 4*48 + 3*4 + 10  =  224
      3 rows   10 + 3*48 + 2*4 + 10  =  172   (a build with no report endpoint)

  There is no 224 anywhere in the resources to disagree with that sum.

  ## The report row is absent in a build with no report endpoint

  See PlayerOverflowMenu. Its gap goes with it, so the menu closes up around it.

  ## Найти трек can be unavailable

  With no identifiable track - the placeholder pair, or metadata still missing -
  there is nothing to search for. The row is still drawn, in its frozen place, so
  the menu does not change shape under the listener; PlayerOverflowMenu disables it
  for that one opening. See there.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_overflow_root"
    android:layout_width="@dimen/player_overflow_menu_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_overflow_menu"
    android:orientation="vertical"
    android:paddingTop="@dimen/player_overflow_menu_pad_top"
    android:paddingBottom="@dimen/player_overflow_menu_pad_bottom">

    <!--
      `Menu row / Найти трек`, row 1 of the frozen four (G4b). The glyph is the
      magnifier the FINAL file draws in the node still named `Icon / disc` - see
      ic_player_overflow_find_track.xml.
    -->
    <LinearLayout
        android:id="@+id/player_overflow_find_track"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_overflow_row_height"
        android:layout_marginStart="@dimen/player_overflow_row_inset"
        android:layout_marginEnd="@dimen/player_overflow_row_inset"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/overflow_row_pad_start"
        android:paddingEnd="@dimen/overflow_row_pad_end">

        <ImageView
            android:layout_width="@dimen/player_overflow_icon_size"
            android:layout_height="@dimen/player_overflow_icon_size"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_player_overflow_find_track" />

        <TextView
            android:id="@+id/player_overflow_find_track_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overflow_label_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/find_track"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.15_22"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- `Menu row / Таймер сна`, row 2 (G2). -->
    <LinearLayout
        android:id="@+id/player_overflow_sleep_timer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_overflow_row_height"
        android:layout_marginStart="@dimen/player_overflow_row_inset"
        android:layout_marginTop="@dimen/player_overflow_row_gap"
        android:layout_marginEnd="@dimen/player_overflow_row_inset"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/overflow_row_pad_start"
        android:paddingEnd="@dimen/overflow_row_pad_end">

        <ImageView
            android:layout_width="@dimen/player_overflow_icon_size"
            android:layout_height="@dimen/player_overflow_icon_size"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_sleep_timer_clock" />

        <!--
          Label 16 after the 24 icon box - card-x 56 in the compact row. Its width
          is what is left after the trailing value's 70, and the value is GONE
          rather than INVISIBLE when the timer is off, so the label then takes the
          row's full remaining width.
        -->
        <TextView
            android:id="@+id/player_overflow_sleep_timer_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overflow_label_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/sleep_timer_title"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.15_22"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/player_overflow_sleep_timer_trailing"
            android:layout_width="@dimen/player_overflow_trailing_width"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
            android:textColor="@color/primary"
            android:visibility="gone"
            tools:text="24 мин"
            tools:visibility="visible" />
    </LinearLayout>

    <!--
      `Menu row / Сообщить о проблеме` 2517:2104, row 3 (G3).

      The glyph is `Icon / alert` in the menu's `textSecondary` rather than in
      `error`: it names an action, it is not a warning about one.

      No trailing value. Only Таймер сна has one in the frozen menu, and only when
      a timer is armed.
    -->
    <LinearLayout
        android:id="@+id/player_overflow_report_problem"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_overflow_row_height"
        android:layout_marginStart="@dimen/player_overflow_row_inset"
        android:layout_marginTop="@dimen/player_overflow_row_gap"
        android:layout_marginEnd="@dimen/player_overflow_row_inset"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/overflow_row_pad_start"
        android:paddingEnd="@dimen/overflow_row_pad_end">

        <ImageView
            android:layout_width="@dimen/player_overflow_icon_size"
            android:layout_height="@dimen/player_overflow_icon_size"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_player_overflow_alert" />

        <TextView
            android:id="@+id/player_overflow_report_problem_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overflow_label_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/report_title"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.15_22"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!--
      `Menu row / История эфира`, row 4 of the frozen four (G4b). `Icon / doc` is
      2517:2114, stroke blob 50165 - the same geometry `Menu / Коллекция`'s export
      rows carry, which G4a already decoded as ic_menu_doc. Measured equal, not
      assumed: both nodes decode to the identical stroke outline.
    -->
    <LinearLayout
        android:id="@+id/player_overflow_history"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_overflow_row_height"
        android:layout_marginStart="@dimen/player_overflow_row_inset"
        android:layout_marginTop="@dimen/player_overflow_row_gap"
        android:layout_marginEnd="@dimen/player_overflow_row_inset"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/overflow_row_pad_start"
        android:paddingEnd="@dimen/overflow_row_pad_end">

        <ImageView
            android:layout_width="@dimen/player_overflow_icon_size"
            android:layout_height="@dimen/player_overflow_icon_size"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_menu_doc" />

        <TextView
            android:id="@+id/player_overflow_history_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overflow_label_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/player_history"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.15_22"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
