<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navgraph"
    app:startDestination="@id/home">

    <!--
      HOME is the first application screen. There is no second full-screen splash
      between it and the platform's own starting window any more: the artwork
      SplashFragment existed to hold the app back until the playlist request had
      finished, and since #63 HOME renders its own loading, error and offline
      states for that section instead. Playlists never gate entering the app.
    -->
    <fragment
        android:id="@+id/home"
        android:name="com.example.musicplayerapp.fragments.MainFragment"
        android:label="MainFragment" >
        <action
            android:id="@+id/action_mainFragment_to_playerFragment"
            app:destination="@id/player"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_mainFragment_to_infoFragment"
            app:destination="@id/info"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_mainFragment_to_streamsFragment"
            app:destination="@id/streams"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/player"
        android:name="com.example.musicplayerapp.fragments.PlayerFragment"
        android:label="PlayerFragment" >
        <action
            android:id="@+id/action_playerFragment_to_streamsFragment"
            app:destination="@id/streams"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_playerFragment_to_mainFragment"
            app:destination="@id/home"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_playerFragment_to_infoFragment"
            app:destination="@id/info"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/info"
        android:name="com.example.musicplayerapp.fragments.InfoFragment"
        android:label="InfoFragment" >
        <action
            android:id="@+id/action_infoFragment_to_playerFragment"
            app:destination="@id/player"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_infoFragment_to_mainFragment"
            app:destination="@id/home"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_infoFragment_to_streamsFragment"
            app:destination="@id/streams"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/favorites"
        android:name="com.example.musicplayerapp.fragments.FavoritesFragment"
        android:label="FavoritesFragment" >
        <action
            android:id="@+id/action_favoritesFragment_to_playerFragment"
            app:destination="@id/player"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_favoritesFragment_to_mainFragment"
            app:destination="@id/home"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_favoritesFragment_to_infoFragment"
            app:destination="@id/info"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <!--
      settings 2517:2758 / 2517:3725 and settings-appearance 2517:2817 /
      2517:3784 (G1).

      Two pushed destinations, and `settings` is what the 40x40 header control on
      HOME, ABOUT US and the empty COLLECTION now opens. It used to open the
      profile directly; the frozen `settings` frame draws `Row / Профиль` as its
      first row, which makes settings the parent surface and the profile a
      destination inside it. Nothing else is navigable that was not before - the
      profile is reached by one more tap, from one more screen.

      MainActivity hides the bottom bar for both, as it does for the profile and
      the auth screens: neither frame has one.

      Neither destination is a root tab and neither pops anything. Back from the
      appearance screen returns to settings; Back from settings returns to
      whichever header opened it, which is why the fragments call popBackStack
      rather than naming a destination - two of the three would be wrong.
    -->
    <fragment
        android:id="@+id/settings"
        android:name="com.example.musicplayerapp.fragments.SettingsFragment"
        android:label="SettingsFragment" >
        <action
            android:id="@+id/action_settings_to_settings_appearance"
            app:destination="@id/settings_appearance"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!--
      The appearance choice. It has no actions of its own: choosing a row writes
      the choice and recreates the activity, and the back stack - including this
      destination - is restored around that. Navigation is not how the screen
      responds to a tap here.
    -->
    <fragment
        android:id="@+id/settings_appearance"
        android:name="com.example.musicplayerapp.fragments.SettingsAppearanceFragment"
        android:label="SettingsAppearanceFragment" />

    <!--
      profile-guest (G-A3). A pushed destination, not a fifth root tab: the four
      bottom-bar items are unchanged and none of them points here.

      Reached from `Settings > Аккаунт > Профиль` since G1. Until then the 40x40
      control in the HOME, ABOUT US and empty-COLLECTION headers opened it
      directly; that control now opens `settings`, which is the surface the frozen
      design makes the parent. `ProfileRoute` still decides which of the two
      profile screens opens, and Back still pops to whatever is underneath - which
      is now settings, and through it whichever header opened that.

      MainActivity hides the bottom bar while this is the current destination,
      which is what the frame shows.
    -->
    <fragment
        android:id="@+id/profile"
        android:name="com.example.musicplayerapp.fragments.ProfileGuestFragment"
        android:label="ProfileGuestFragment" >
        <action
            android:id="@+id/action_profile_to_auth_sign_in"
            app:destination="@id/auth_sign_in"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_profile_to_auth_create_account"
            app:destination="@id/auth_create_account"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <!--
          G-A8d. The one way back up, and it exists for exactly one situation: this
          screen was showing the pending-deletion presentation, the deletion was then
          refused, and the account it belongs to is still there. `ProfileRoute` makes
          that decision - the same one that routes every other entry - and this is how
          its answer is acted on.

          `popUpTo` the guest profile inclusive, like the two auth actions land: the
          screen that was showing "checking your deletion" must not be reachable by
          Back once it is known there is nothing to check.

          It is an action, not a destination. Nothing new is navigable.
        -->
        <action
            android:id="@+id/action_profile_to_profile_authenticated"
            app:destination="@id/profile_authenticated"
            app:popUpTo="@id/profile"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!--
      auth-sign-in 2517:2603 / 2517:3570 and auth-create-account 2517:2624 /
      2517:3591 (G-A4c1). Pushed destinations reached from profile-guest, and like
      it they have no bottom bar - MainActivity hides it for all three.

      ## The two swap rather than stack

      Each cross-link pops the screen it came from. Without that, Create account
      then Already have an account then Create account again builds an unbounded
      pile of auth screens, and Back walks the listener back through every
      indecisive tap they made. With it there is never more than one auth entry on
      the stack, so Back from either screen returns to the profile - one rule, and
      it is the same rule wherever the listener entered from.
    -->
    <fragment
        android:id="@+id/auth_sign_in"
        android:name="com.example.musicplayerapp.fragments.AuthSignInFragment"
        android:label="AuthSignInFragment" >
        <!--
          Where a successful sign-in lands. `popUpTo` the profile *inclusive* clears
          this screen, whichever auth screen preceded it, and the guest profile
          underneath - so Back from the account card returns to whatever opened the
          profile in the first place, and the form that has just been satisfied is
          not sitting behind it.
        -->
        <action
            android:id="@+id/action_auth_sign_in_to_profile_authenticated"
            app:destination="@id/profile_authenticated"
            app:popUpTo="@id/profile"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_auth_sign_in_to_auth_create_account"
            app:destination="@id/auth_create_account"
            app:popUpTo="@id/auth_sign_in"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <!--
          Recovery is the one auth link that does NOT pop what it came from. The two
          cross-links above swap one form for another and Back should skip the one the
          listener rejected; recovery is an errand *inside* signing in, and somebody who
          abandons it wants the half-filled sign-in form back rather than the profile.
          The stack is still bounded: recovery has no cross-links of its own.
        -->
        <action
            android:id="@+id/action_auth_sign_in_to_auth_recovery"
            app:destination="@id/auth_recovery"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!--
      auth-recovery (G-A4c2). Three states in one destination - request, code, done -
      because they are one errand and the address belongs to one ViewModel rather than
      to a back stack. Composed from the auth screens' primitives; no frame draws it.
    -->
    <fragment
        android:id="@+id/auth_recovery"
        android:name="com.example.musicplayerapp.fragments.AuthRecoveryFragment"
        android:label="AuthRecoveryFragment" >
        <!--
          Where a completed recovery lands, and it is the sign-in action's rule exactly:
          verifying the code authenticated this install, so the form behind it and the
          guest profile under that are both false about the listener now.
        -->
        <action
            android:id="@+id/action_auth_recovery_to_profile_authenticated"
            app:destination="@id/profile_authenticated"
            app:popUpTo="@id/profile"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/auth_create_account"
        android:name="com.example.musicplayerapp.fragments.AuthCreateAccountFragment"
        android:label="AuthCreateAccountFragment" >
        <action
            android:id="@+id/action_auth_create_account_to_profile_authenticated"
            app:destination="@id/profile_authenticated"
            app:popUpTo="@id/profile"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_auth_create_account_to_auth_sign_in"
            app:destination="@id/auth_sign_in"
            app:popUpTo="@id/auth_create_account"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!--
      profile-authenticated 2517:2671 / 2517:3638 (G-A5a). A pushed destination
      alongside profile-guest, not instead of it: which one opens is decided by
      ProfileRoute from the persisted identity, so the 40x40 control keeps one
      listener and neither screen has to know about the other.

      No bottom bar, like the profile and the two auth screens.

      Both actions below **replace** rather than stack, and for the same reason in
      each direction: after signing out, Back must not reach an account card that is
      no longer true; after signing in, it must not reach a guest card or the sign-in
      form that has just been satisfied.
    -->
    <fragment
        android:id="@+id/profile_authenticated"
        android:name="com.example.musicplayerapp.fragments.ProfileAuthenticatedFragment"
        android:label="ProfileAuthenticatedFragment" >
        <action
            android:id="@+id/action_profile_authenticated_to_profile"
            app:destination="@id/profile"
            app:popUpTo="@id/profile_authenticated"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

</navigation>