<?xml version="1.0" encoding="utf-8"?>
<!--
  3.6.6 semantic colours - DARK.

  The dark half of the eleven v1 roles from
  tools/figma-export/canonical/semantic-tokens.json.

  Only the semantic roles appear here. The legacy colours - purple_*, teal_*,
  black, white, main_fragment, myata_accent - are deliberately NOT overridden,
  so every screen that still reads them resolves the same value in both modes
  and looks exactly as it does today.

  Creating this folder does not switch anything to dark. The app themes are still
  Theme.MaterialComponents.Light.*, and values-v29 sets forceDarkAllowed false.
  Dark mode arrives when the themes move in A3 and the screens migrate in Phase B.

  Note that navigation_container equals surface in dark (#142D47) but differs in
  light (#EDEEEF vs #FFFFFF). They stay separate roles on purpose: collapsing
  them would be correct in dark and wrong in light.
-->
<resources>
    <color name="background">#0F253E</color>
    <color name="surface">#142D47</color>
    <color name="surface_container">#1C4771</color>
    <color name="navigation_container">#142D47</color>
    <color name="menu_surface">#142D47</color>
    <color name="text_primary">#F5F7FA</color>
    <color name="text_heading">#F5F7FA</color>
    <color name="text_secondary">#B3C4D1</color>
    <color name="outline">#466D8F</color>
    <color name="primary">#5FD9B4</color>
    <color name="on_primary">#0F253E</color>

    <!--
      Mini Player (B2). The only one of its five colours that differs between the
      canonical Light and Dark pages - see the block in values/colors.xml for why
      the other four deliberately have no entry here.
    -->
    <color name="mini_player_artist">#B3C4D1</color>

    <!--
      PLAYER header label. Exactly text_primary in dark, while its light value is
      exactly text_secondary - see values/colors.xml for why that forces a pair.
    -->
    <color name="player_header_label">#F5F7FA</color>

    <!--
      PLAYER swipe indicator, inactive pages. Dark states a solid #6F899F where
      light states `primary` at 50% - see values/colors.xml for why that forces a
      pair. The active marker is `primary` in both and has no resource here.
    -->
    <color name="player_swipe_inactive">#FF6F899F</color>

    <!--
      PLAYER `like` glyph at rest. Exactly text_primary in dark, while its light
      value is a green-cast neighbour of text_secondary - see values/colors.xml.
    -->
    <color name="player_like">#F5F7FA</color>

    <!--
      PLAYER control row, trailing action. The frozen `dislike` glyph, which the
      History entry occupies until its own phase - see values/colors.xml.
    -->
    <color name="player_control_action">#F5F7FA</color>

    <!--
      COLLECTION header trailing action. Exactly text_primary in dark while its
      light value is exactly text_secondary - see values/colors.xml for why that
      forces a pair rather than a role.
    -->
    <color name="collection_header_action">#F5F7FA</color>

    <!--
      COLLECTION empty-state illustration - the two disc rings the frozen design
      changes between the pages. The hub, the spindle, the badge plate and the
      heart are identical on both and deliberately have no entry here.
    -->
    <color name="collection_empty_disc_outer">#FFCCFF</color>
    <color name="collection_empty_disc_inner">#E29AE2</color>
</resources>
