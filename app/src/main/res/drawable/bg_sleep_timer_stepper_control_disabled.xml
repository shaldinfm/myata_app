<?xml version="1.0" encoding="utf-8"?>
<!--
  The same control at a bound it cannot cross - minus at 0 ч 0 мин, plus at 12 ч.
  sleep-timer-custom-invalid draws that border in `outline` rather than `primary`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/sheet_stroke"
        android:color="@color/outline" />
    <corners android:radius="@dimen/sleep_timer_stepper_control_radius" />
</shape>
