<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Shared mobile shell, migrated to the frozen 3.6.6 canonical design (B1).

      Background is the `background` semantic role, so it resolves #F8F9FA in
      Light and #0F253E in Dark rather than the hardcoded navy it carried before.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/navgraph" />

        <!--
          Bottom navigation.

          Frozen canonical BottomNavBar: 390x76, top corners r=12, full width and
          flush with the bottom of the screen - not the floating pill it used to
          be. Four destinations, each icon plus label, with a #FFCCFF pill behind
          the active one.

          The frozen items are content-sized at fixed offsets, which totals about
          349dp and does not fit a 320dp screen. They are equally weighted here so
          the bar adapts from 320dp upward; at 390dp that places each item within
          a few dp of the frozen position.
        -->
        <LinearLayout
            android:id="@+id/bottomNavView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_nav"
            android:orientation="horizontal"
            android:paddingTop="13dp"
            android:paddingBottom="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/nav_item_home"
                style="@style/BottomNavItem">

                <ImageView
                    android:id="@+id/home_btn"
                    style="@style/BottomNavIcon"
                    android:src="@drawable/home_new" />

                <TextView
                    android:id="@+id/home_label"
                    style="@style/BottomNavLabel"
                    android:text="@string/nav_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_player"
                style="@style/BottomNavItem">

                <ImageView
                    android:id="@+id/player_btn"
                    style="@style/BottomNavIcon"
                    android:src="@drawable/player_new" />

                <TextView
                    android:id="@+id/player_label"
                    style="@style/BottomNavLabel"
                    android:text="@string/nav_player" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_favorites"
                style="@style/BottomNavItem">

                <ImageView
                    android:id="@+id/favorites_btn"
                    style="@style/BottomNavIcon"
                    android:src="@drawable/ic_favorites_nav" />

                <TextView
                    android:id="@+id/favorites_label"
                    style="@style/BottomNavLabel"
                    android:text="@string/nav_collection" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_info"
                style="@style/BottomNavItem">

                <ImageView
                    android:id="@+id/info_btn"
                    style="@style/BottomNavIcon"
                    android:src="@drawable/info_new" />

                <TextView
                    android:id="@+id/info_label"
                    style="@style/BottomNavLabel"
                    android:text="@string/nav_about" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
