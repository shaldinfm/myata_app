<?xml version="1.0" encoding="utf-8"?>
<!--
  PLAYER header trailing overflow.

  Frozen canonical: `PLAYER` > `Main` > `Player Section` >
  `Mobile Header (Subtle):margin` > `Mobile Header (Subtle)` > the trailing
  `Button:margin` (32.02x39 at x=325.98, y=4) > `Button` > `Container` > `Icon`, a
  4x16 dot column - the same glyph and the same box the COLLECTION header carries.

  The canonical exporter records a vector's box and its fills but never its
  geometry, so the dots are authored from the box exactly as
  ic_collection_overflow's are: three 4-wide dots on a 16 column, leaving a 2 gap,
  centred in a 24 canvas.

  Its own colour resource rather than collection_header_action - see colors.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/player_header_action">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,6 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,12 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,18 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
</vector>
