<?xml version="1.0" encoding="utf-8"?>
<!--
  ABOUT US, Section 3 social tile. Frozen 2411:31678 / 2444:18624: 76x76, radius
  12, 1px stroke #1C3F5F on both canonical pages, over a fill that lands on
  `surface_container` exactly in BOTH themes - the cleanest role match on the
  screen, and the reason the tile itself needed no new colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container" />
    <stroke android:width="1dp" android:color="@color/brand_about_social_outline" />
    <corners android:radius="@dimen/about_button_corner" />
</shape>
