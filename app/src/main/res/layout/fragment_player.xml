<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PLAYER shell, migrated to the frozen 3.6.6 canonical design (Phase B).

      Source: the canonical `PLAYER` / `PLAYER_dark` frames. The screen is a flat
      `background` fill - the frozen design has no full-bleed stream artwork behind
      the player, only the album art and its backdrop.

      This file owns the chrome that does not swipe. `Mobile Header (Subtle)` says
      "Сейчас играет" on every stream and the swipe dots describe the pager itself,
      so both stay still while the pages move underneath; the per-stream content
      lives in fragment_myata_stream.xml and starts at the frozen 79.

        16   header row top      63   header row bottom / swipe top
        73   swipe bottom        79   page top
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!--
          Header row, 358x47 at 16. The label is centred because both ends reserve
          a slot: the frozen leading Button is hidden, and the trailing overflow is
          reserved but not drawn - see player_header_action.
        -->
        <FrameLayout
            android:id="@+id/player_header"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_header_height"
            android:layout_marginStart="@dimen/player_margin"
            android:layout_marginTop="@dimen/player_margin"
            android:layout_marginEnd="@dimen/player_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!--
              The frozen label is `textCase: UPPER` with 0.6px of tracking at 12,
              so it reads "СЕЙЧАС ИГРАЕТ". The string keeps the source characters
              the design stores and textAllCaps does what Figma's case does;
              0.6/12 is the 0.05em below.
            -->
            <TextView
                android:id="@+id/player_header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:text="@string/player_now_playing"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.12_16"
                android:textColor="@color/player_header_label" />

            <!--
              The frozen overflow control, in the box that was reserved for it.

              Canonical `PLAYER` > `Mobile Header (Subtle)` > the trailing
              `Button:margin`, 32.02x39 at x=325.98 - the same 32x39 the Space
              occupied, so the label stays centred exactly where it was and nothing
              frozen moves. `PlayerLayoutTest` measures that rather than trusting it.

              It opens `Menu / Плеер` with **one** row, Таймер сна. The other
              three - Найти трек, Сообщить о проблеме, История эфира - do not
              exist, and are absent rather than drawn inert: see
              menu_player_overflow.xml, which sets out why three greyed rows would
              be worse than three missing ones.

              G1 left this slot empty because the menu would then have been "a menu
              with one *unrelated* row" - it was being asked to carry Настройки,
              which is not one of the player's actions. Таймер сна is one of the
              four. Settings is still reached from the HOME header and is still not
              on this menu. See docs/SETTINGS-APPEARANCE-3.6.6.md and
              docs/SLEEP-TIMER-3.6.6.md.
            -->
            <ImageView
                android:id="@+id/player_header_action"
                android:layout_width="@dimen/player_header_action_width"
                android:layout_height="@dimen/player_header_action_height"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_overflow_description"
                android:scaleType="center"
                android:src="@drawable/ic_player_overflow" />
        </FrameLayout>

        <!--
          `swipe`: which of MYATA / GOLD / XTRA is showing.

          Three 10x10 slots edge to edge - the frozen row has itemSpacing 0 - each
          holding a marker about 8.4 across, centred. The active page is a
          nine-lobed cookie at full `primary`; the other two are plain circles in
          the declared inactive pair. `scaleType=center` draws each marker at its
          own intrinsic size, so the 10 slot stays the frozen slot and the shape
          inside it stays the frozen shape.

          `isSelected` drives the tint through player_swipe_tint; PlayerFragment
          sets it together with the drawable.
        -->
        <LinearLayout
            android:id="@+id/dots_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_header">

            <ImageView
                android:id="@+id/dot_1"
                style="@style/PlayerSwipeDot"
                android:src="@drawable/ic_player_swipe_active" />

            <ImageView
                android:id="@+id/dot_2"
                style="@style/PlayerSwipeDot"
                android:src="@drawable/ic_player_swipe_inactive" />

            <ImageView
                android:id="@+id/dot_3"
                style="@style/PlayerSwipeDot"
                android:src="@drawable/ic_player_swipe_inactive" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/player_page_gap"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dots_indicator"
            tools:layout_height="600dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
