<?xml version="1.0" encoding="utf-8"?>
<!--
  ABOUT US social tile glyph, 48x48 inside the frozen 76x76 tile.

  The frozen Threads tile (2419:121 / 2444:18639) carries a single 42x48 vector,
  but the canonical exporter records geometry only - it never calls
  getBytesAsync/exportAsync, so no path data for it exists anywhere in this
  repository, and unlike the other seven this glyph had no prior art in
  res/drawable to recolour either.

  So this one is AUTHORED, not extracted: an open ring with the mark's lower
  loop, drawn as two stroked arcs on a 48 viewport so the geometry stays
  readable and checkable rather than being an opaque blob of cubics. It fills
  the frozen 42x48 box and reads correctly at tile size in both themes.

  It is an approximation of a third-party brand mark and is the one asset on
  this screen not traceable to the design. Replace it with the official Threads
  asset when the owner supplies one - nothing else about the tile changes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
  <!-- Outer ring, open on the right between -55 and +55 degrees. -->
  <path
      android:strokeColor="@color/about_social_icon"
      android:strokeWidth="4.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M34.9,8.44 A19,19 0 1 0 34.9,39.56"/>
  <!-- The lower loop, continuing from where the ring stops. -->
  <path
      android:strokeColor="@color/about_social_icon"
      android:strokeWidth="4.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M34.9,39.56 C31.5,44 24.5,45.5 19.6,42.2 C15,39.1 15.4,32.6 20.5,30.2 C26.3,27.5 34.2,29.7 37,36.2 C39,40.9 37.7,45.6 33.4,47.6"/>
</vector>
