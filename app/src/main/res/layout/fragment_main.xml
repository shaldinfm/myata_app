<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      HOME, migrated to the frozen 3.6.6 canonical design (Phase B).

      Source: the canonical `HOME` / `HOME_dark` frames. 390x757, background is the
      `background` semantic role, `Header - TopAppBar` 0..64, `Main` 64..628 with
      16 padding and 16 gaps. Anchors reproduced exactly:

        Наши потоки        y=80     streams row     y=132   cards 316x198 r14
        Мятные плейлисты   y=363    playlists row   y=415   cards 160x160 r20

      Two structural notes.

      **It scrolls now.** The frozen frame is a fixed 757 and the old layout
      matched it by weighting its rows, so the cards stretched or squashed with the
      screen and no device saw the frozen sizes. Here the cards are the frozen
      sizes and the screen scrolls when it cannot fit them, which is how a fixed
      design is presented on a viewport that varies. Every interactive behaviour is
      unchanged: the same three stream targets, the same playlist list, the same
      horizontal scrolling inside each row.

      **The rows are taller than their cards, deliberately.** The canonical
      containers are 215 and 197 against cards of 198 and 181, and that slack is
      what puts the next section at its canonical y. Reproducing the card heights
      alone would pull Мятные плейлисты 17 up.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:context=".fragments.MainFragment">

            <!--
              Header - TopAppBar, 390x64, the greeting vertically centred and 16
              from the leading edge, and the 40x40 profile control on the trailing
              one (2393:1665 / 2444:10389).

              The band already reserved this space, so landing the control moves
              nothing: the greeting keeps its height, its 16dp leading padding and
              its vertical centring, and only stops being the sole child. The
              trailing 16dp that used to be the greeting's own padding is now the
              row's, which is what puts the circle's right edge at 374 of 390.
            -->
            <LinearLayout
                android:id="@+id/home_header"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_header_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/home_margin"
                android:paddingEnd="@dimen/home_margin">

                <TextView
                    android:id="@+id/home_greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_greeting"
                    android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                    android:textColor="@color/text_heading" />

                <include
                android:id="@+id/settings_entry"
                layout="@layout/view_settings_entry" />
            </LinearLayout>

            <!--
              Main. clipToPadding=false so the reserved bottom clearance is scroll
              room rather than a dead band, and so the cards' shadows are not cut
              at the edges of the rows.
            -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/home_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="@dimen/content_bottom_clearance"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/home_margin">

                    <!--
                      minHeight is the token's own line height, for the reason
                      measured in B2: a token applied to a single line arrives as
                      line spacing, StaticLayout adds none after the last line, and
                      the view would measure at the font's natural height instead
                      of the frozen 36. Without it the streams row starts half a dp
                      high and every anchor below drifts with it.
                    -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/line_height_montserrat_bold_28_36"
                        android:paddingStart="@dimen/home_margin"
                        android:paddingEnd="@dimen/home_margin"
                        android:text="@string/home_streams_heading"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Bold.28_36"
                        android:textColor="@color/text_heading" />

                    <!--
                      Live Streams Section. The cards are the existing brand
                      banners, which are already authored at exactly the frozen
                      316x198 - nothing is rescaled.
                    -->
                    <HorizontalScrollView
                        android:id="@+id/streams"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_stream_row_height"
                        android:layout_marginTop="@dimen/home_section_gap"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/home_margin"
                        android:paddingEnd="@dimen/home_margin"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/myata_stream_banner_container"
                                style="@style/HomeStreamCard">

                                <ImageView
                                    android:id="@+id/myata_stream_banner"
                                    style="@style/HomeStreamCardImage"
                                    android:contentDescription="@string/home_stream_myata"
                                    android:src="@drawable/myata_banner_new" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/gold_stream_banner_container"
                                style="@style/HomeStreamCard"
                                android:layout_marginStart="@dimen/home_stream_card_gap">

                                <ImageView
                                    android:id="@+id/gold_stream_banner"
                                    style="@style/HomeStreamCardImage"
                                    android:contentDescription="@string/home_stream_gold"
                                    android:src="@drawable/gold_banner_new" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/xtra_stream_banner_container"
                                style="@style/HomeStreamCard"
                                android:layout_marginStart="@dimen/home_stream_card_gap">

                                <ImageView
                                    android:id="@+id/xtra_stream_banner"
                                    style="@style/HomeStreamCardImage"
                                    android:contentDescription="@string/home_stream_xtra"
                                    android:src="@drawable/xtra_banner_new" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/playlistString"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_section_gap"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/line_height_montserrat_bold_28_36"
                        android:paddingStart="@dimen/home_margin"
                        android:paddingEnd="@dimen/home_margin"
                        android:text="@string/home_playlists_heading"
                        android:textAppearance="@style/TextAppearance.Myata.Montserrat.Bold.28_36"
                        android:textColor="@color/text_heading" />

                    <!--
                      Mint Playlists Section. The frozen `Horizontal Scroll
                      Container` starts at 16 and runs to the screen edge, so the
                      row has a leading inset and no trailing one - the last card's
                      own 16 gap provides the trailing air.
                    -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/playlists"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_playlist_row_height"
                        android:layout_marginTop="@dimen/home_section_gap"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/home_margin"
                        tools:listitem="@layout/rw_playlist_item" />

                    <!--
                      The playlist section's inline status, shown in place of the
                      card row while there is nothing to put in it.

                      Same height and same top margin as the row it replaces, and
                      only ever one of the two is visible, so the section occupies
                      an identical band whichever it is and nothing below moves
                      when the load lands. The card design is untouched: this is a
                      sibling, not a wrapper.

                      It is deliberately compact. HOME stays fully usable while
                      playlists are missing - the streams above it are the radio,
                      and they need no network to be tapped - so a failure here is
                      a section that could not fill itself, not a screen-wide
                      error. That is the whole difference from the full-screen
                      splash this replaces.
                    -->
                    <FrameLayout
                        android:id="@+id/playlist_state"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_playlist_row_height"
                        android:layout_marginTop="@dimen/home_section_gap"
                        android:paddingStart="@dimen/home_margin"
                        android:paddingEnd="@dimen/home_margin"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ProgressBar
                            android:id="@+id/playlist_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/text_secondary" />

                        <LinearLayout
                            android:id="@+id/playlist_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/playlist_error_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.16_22"
                                android:textColor="@color/text_secondary"
                                tools:text="@string/splash_error_title" />

                            <Button
                                android:id="@+id/playlist_retry"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/home_section_gap"
                                android:text="@string/splash_retry"
                                android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.16_22"
                                android:textColor="@color/primary" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </FrameLayout>
</layout>
