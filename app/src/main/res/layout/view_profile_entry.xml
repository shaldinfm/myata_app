<?xml version="1.0" encoding="utf-8"?>
<!--
  The 40x40 circular profile entry control.

  One file, `<include>`d by the three headers that carry it, so HOME, ABOUT US
  and the empty COLLECTION cannot drift apart: the Figma nodes 2393:1665,
  2413:58 and 2429:352 are one component and this is one layout.

  Geometry, from the FINAL Figma file: a 40x40 circle at x=334,y=12 inside the
  390x64 band. 390-334-40 = 16, which is the trailing padding those headers
  already have, so this is simply the last child of the header row rather than a
  positioned view - and that is why nothing below the band moves when it lands.
  The 16x16 glyph sits at x=12,y=12 inside the circle, which is the padding here.

  Not carried by the populated COLLECTION, which keeps its three-dot overflow
  (2399:31129 / 2444:18376), nor by PLAYER.
-->
<!--
  Wrapped in <layout> so data binding generates ViewProfileEntryBinding and the
  three headers reach it as `binding.profileEntry.root`. A plain include of a
  non-binding layout gets no generated field at all, which is the compile error
  this shape avoids.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/profile_entry_icon"
        android:layout_width="@dimen/profile_entry_size"
        android:layout_height="@dimen/profile_entry_size"
        android:background="@drawable/bg_profile_entry"
        android:contentDescription="@string/profile_entry_description"
        android:padding="@dimen/profile_entry_icon_inset"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_person_generic"
        app:tint="@color/profile_entry_icon" />
</layout>
