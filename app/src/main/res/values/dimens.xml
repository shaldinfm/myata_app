<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bottom navigation, frozen 3.6.6 canonical BottomNavBar (390x76).

      The side padding lives here rather than only in the layout because the
      window-inset listener rewrites the bar's padding at runtime; it reads these
      so the frozen horizontal values survive that rewrite.
    -->
    <dimen name="bottom_nav_padding_start">23.32dp</dimen>
    <dimen name="bottom_nav_padding_end">18dp</dimen>
    <dimen name="bottom_nav_padding_bottom">17dp</dimen>

    <!--
      Mini Player, frozen 3.6.6 canonical (B2).

      Every number is measured off `Now Playing Mini Player (Floating above Bottom
      Nav)`, which on the 390px reference frame is 358 wide at x=16, 74 tall, and
      sits 4px above the BottomNavBar on HOME, COLLECTION and COLLECTION pusto.
      ABOUT US is the one outlier at 6px; three screens against one, so 4.

      The pill is a horizontal auto-layout with 12px padding and a 1px INSIDE
      stroke, and Figma offsets its children by both: the artwork starts at x=13,
      y=13. On Android an inside stroke is painted within the view rather than
      added to it, so the 13 is expressed as padding and the stroke is drawn by
      bg_mini_player. That lands every canonical anchor exactly - artwork 13,
      text 73, button 318, trailing edge 345 - and makes the pill 13+48+13 = 74.

      Height is deliberately NOT fixed. Figma's own frame hugs its content
      vertically, and the tallest child is the 48px artwork; the text column comes
      to 27.5+20 = 47.5 and so never governs. That is what allows the title to
      carry its real 27.5 line height instead of the broken 18px box on the
      canonical page, at no cost to the outer 74.
    -->
    <dimen name="mini_player_margin_horizontal">16dp</dimen>
    <dimen name="mini_player_margin_bottom">4dp</dimen>
    <!-- 1px stroke + 12px auto-layout padding -->
    <dimen name="mini_player_padding">13dp</dimen>
    <dimen name="mini_player_gap">12dp</dimen>
    <dimen name="mini_player_corner">16dp</dimen>
    <dimen name="mini_player_stroke">1dp</dimen>
    <dimen name="mini_player_artwork_size">48dp</dimen>
    <dimen name="mini_player_artwork_corner">8dp</dimen>
    <!-- Button slot: 27 wide in the frozen row. Full row height for the target. -->
    <dimen name="mini_player_button_width">27dp</dimen>
    <dimen name="mini_player_button_height">48dp</dimen>

    <!--
      HOME, frozen 3.6.6 canonical.

      Every number is measured off the canonical HOME frame, which is 390x757 with
      `Header - TopAppBar` 0..64 and `Main` 64..628 at 16 padding and 16 gaps.
      Reproducing the two section containers at their authored heights - 215 for
      the streams row and 197 for the playlists row, both taller than the cards
      they hold - is what lands every canonical anchor exactly:

        heading    80    streams  132    heading  363    playlists  415
    -->
    <dimen name="home_header_height">64dp</dimen>
    <dimen name="home_margin">16dp</dimen>
    <dimen name="home_section_gap">16dp</dimen>

    <!-- `плашка потока MYATA/GOLD`, 316x198 r14, next card 15 away. -->
    <dimen name="home_stream_row_height">215dp</dimen>
    <dimen name="home_stream_card_width">316dp</dimen>
    <dimen name="home_stream_card_height">198dp</dimen>
    <dimen name="home_stream_card_corner">14dp</dimen>
    <dimen name="home_stream_card_gap">15dp</dimen>

    <!-- `Playlist N > Background`, 160x160 r20, pitch 176 so the gap is 16. -->
    <dimen name="home_playlist_row_height">197dp</dimen>
    <dimen name="home_playlist_card_size">160dp</dimen>
    <dimen name="home_playlist_card_corner">20dp</dimen>
    <dimen name="home_playlist_card_gap">16dp</dimen>

    <!--
      Bottom clearance: the height of the chrome that floats over the content.

        BottomNavBar          76   (canonical, 680.5..756.5 of a 757 frame)
        gap                    4   (mini_player_margin_bottom)
        Mini Player           74   (13 + 48 + 13)
        total                154

      Derived from the three canonical boxes rather than picked. Note this is not
      the HOME frame's own `paddingBottom: 128`: that number is the leftover of a
      fixed 757-tall frame that never scrolls, and it stops 26 short of the pill.
      It works in Figma only because the last 26 is the playlist row's own empty
      slack. On a screen that scrolls, the last real content would end up under
      the pill, which is the failure this reserves against.

      The system bar inset is added on top of this at runtime, because
      MainActivity adds the same inset to the navigation bar's own padding.
    -->
    <dimen name="home_content_bottom_clearance">154dp</dimen>
</resources>
