      than the row's middle. The paddings below reproduce that.
    -->
    <dimen name="player_action_icon_width">24.5dp</dimen>
    <dimen name="player_action_icon_height">23.33dp</dimen>
    <dimen name="player_action_icon_inset">12dp</dimen>
    <dimen name="player_action_icon_inset_bottom">19dp</dimen>

