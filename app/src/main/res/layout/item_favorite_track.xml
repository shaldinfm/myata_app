<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#0A1D33"
    app:cardCornerRadius="16dp"
    app:strokeColor="#1E3754"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!--
          Top Section: Info and Badge.

          Title above artist, matching the FINAL canonical Collection row, where
          the track is the Heading 3 and the artist is the secondary line below
          it. Android had them reversed.

          Only the constraint chain moved: the title now hangs off the parent top
          and the artist off the title. Each view keeps its own ellipsis
          behaviour - the title one line, the artist up to two - so nothing
          truncates that did not truncate before. Colours stay exactly where they
          were: the near-white was already on the title and the accent on the
          artist, so the order change puts them the right way round by itself.
        -->
        <TextView
            android:id="@+id/tv_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#F5F7FA"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.16_28"
            android:text="Track Title"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/badge_stream"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#00E5FF"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.12_20"
            android:text="ARTIST NAME"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_track"
            app:layout_constraintEnd_toStartOf="@id/badge_stream"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/badge_stream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#000000"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="@font/onest_black"
            android:background="@drawable/rounded_banner_bg"
            android:text="MYATA"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Separator -->
        <View
            android:id="@+id/separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E3754"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_artist"/>

        <!-- Bottom Section: Services and Delete -->
        <LinearLayout
            android:id="@+id/music_services"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/separator"
            app:layout_constraintEnd_toStartOf="@id/btn_delete"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/btn_spotify"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_spotify"
                android:background="@android:color/transparent"
                android:contentDescription="Spotify"/>

            <ImageView
                android:id="@+id/btn_apple_music"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_apple_music"
                android:background="@android:color/transparent"
                android:contentDescription="Apple Music"/>

            <ImageView
                android:id="@+id/btn_yandex"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_yandex"
                android:background="@android:color/transparent"
                android:contentDescription="Yandex Music"/>

            <ImageView
                android:id="@+id/btn_youtube"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_youtube"
                android:background="@android:color/transparent"
                android:contentDescription="YouTube"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/dismiss_cross"
            android:alpha="0.4"
            app:tint="#FFFFFF"
            android:background="@android:color/transparent"
            android:contentDescription="Delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/music_services"
            app:layout_constraintBottom_toBottomOf="@id/music_services"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
