<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.SplashFragment">

        <ImageView
            android:id="@+id/splash_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Offline / load-failure state. Hidden until the playlist load gives up,
             so the normal splash appearance is unchanged (issue #9). -->
        <FrameLayout
            android:id="@+id/splash_error_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.8"
                android:background="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <TextView
                    android:id="@+id/splash_error_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_black"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    tools:text="@string/splash_offline_title" />

                <TextView
                    android:id="@+id/splash_error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.75"
                    android:fontFamily="@font/onest_regular"
                    android:gravity="center"
                    android:text="@string/splash_error_message"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/splash_retry_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/myata_accent"
                    android:fontFamily="@font/montserrat_bold"
                    android:minWidth="184dp"
                    android:minHeight="48dp"
                    android:text="@string/splash_retry"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</layout>
