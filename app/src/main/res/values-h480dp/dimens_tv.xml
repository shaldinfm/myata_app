<?xml version="1.0" encoding="utf-8"?>
<!--
  TV player metrics from 480dp of height up to 519dp - the viewport an hdpi
  1280x720 panel or box reports (853x480dp), where the audit measured the
  artwork clipped by 31dp off the top of the screen.

  200 artwork + 16 gap + 24 track line + 16 + 42 + 16 + 50 + 40 = 404dp. The
  chain is anchored at the bottom, so the 76dp that are left over sit above the
  artwork - and the artwork's own bias puts four fifths of that there and one
  fifth between itself and the title.

  Measured on the 1280x720@240 TV AVD: the artwork used to start 26dp below the
  top of the frame, which read as glued to it, with the artwork itself taking 50%
  of the viewport's height. It now starts 61dp down and is 42% - smaller, with
  real air above it, and the column below it unmoved.
-->
<resources>
    <dimen name="tv_player_artwork_size">200dp</dimen>
    <dimen name="tv_player_artwork_gap">16dp</dimen>
    <dimen name="tv_player_bottom_inset">40dp</dimen>
</resources>
