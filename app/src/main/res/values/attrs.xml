<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The line height of a typography token, in a namespace that exists on every
      API level this app runs on.

      android:lineHeight is API 28. That is not only a problem for whether the
      framework *honours* it - it is a problem for reading it back at all: the
      attribute's resource id is defined by the framework, so on API 24 a lookup
      of android:lineHeight in a style finds nothing, and a compat layer trying to
      recover the value gets -1 rather than the number written in the token. This
      attribute is the app's own resource, so it resolves identically on 24 and on
      36, and it is what MyataTypography reads.

      The tokens declare both. They are generated from one value so they cannot
      disagree, and android:lineHeight earns its place by still being there for
      anything that applies a token without going through MyataTypography on a
      device new enough to act on it.
    -->
    <attr name="myataLineHeight" format="dimension" />

    <!--
      Which frozen drop shadow a SoftShadowFrame draws.

      An enum rather than a set of dx/dy/blur/spread attributes: the parameters
      are not a designer's free choice per call site, they are two specific
      effects in the frozen file, and naming them keeps a layout from inventing a
      third. See SoftShadowFrame for the values each one carries.
    -->
    <!--
      The colour of a BufferingDotsView's dots. Required rather than defaulted:
      the two surfaces that use it - the Mini Player's navy pill and the PLAYER's
      primary control - have different foreground roles, and a default would
      silently pick the wrong one on whichever surface it was not written for.
    -->
    <declare-styleable name="BufferingDotsView">
        <attr name="dotColor" format="color|reference" />
    </declare-styleable>

    <declare-styleable name="SoftShadowFrame">
        <attr name="softShadowSpec" format="enum">
            <enum name="homeStreamCard" value="0" />
            <enum name="playerArtwork" value="1" />
        </attr>
    </declare-styleable>
</resources>
