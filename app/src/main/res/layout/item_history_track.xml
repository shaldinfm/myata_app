<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Content padding container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Time -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/info_container"
            app:layout_constraintBottom_toBottomOf="@id/info_container"
            android:text="12:34"/>

        <!-- Track Info -->
        <LinearLayout
            android:id="@+id/info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/tv_time"
            app:layout_constraintEnd_toStartOf="@id/music_services"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.14_20"
                android:text="ARTIST NAME"/>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textAppearance="@style/TextAppearance.Myata.Onest.Regular.17_28"
                android:text="Track Title"/>
        </LinearLayout>

        <!-- Music Service Icons -->
        <LinearLayout
            android:id="@+id/music_services"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/btn_spotify"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_spotify"
                android:background="@android:color/transparent"
                android:contentDescription="Spotify"/>

            <ImageView
                android:id="@+id/btn_apple_music"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_apple_music"
                android:background="@android:color/transparent"
                android:contentDescription="Apple Music"/>

            <ImageView
                android:id="@+id/btn_yandex"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_yandex"
                android:background="@android:color/transparent"
                android:contentDescription="Yandex Music"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/item_content"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
