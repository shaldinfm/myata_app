<?xml version="1.0" encoding="utf-8"?>
<!--
  HOME vertical composition, the frozen numbers - everything at 757dp of
  available height and above.

  757 is the frozen HOME frame's own height, so this reads as "the
  composition the design was drawn for fits; use it". `Main` then starts 16 under
  the header, the three section gaps are 16, and the playlists container is its
  authored 197 - which is what puts the headings at y=80/363 and the rows at
  y=132/415 exactly as the frozen frame does.

  Below this the values in values/dimens.xml apply and the screen spends 37dp
  less on gaps and on the playlist row's dead space. Nothing else changes: the
  cards, the type and the touch targets are the same on a 640dp screen as on a
  914dp one, and the 154dp bottom clearance is untouched at every height.

  `h` is available screen height, which API 24 reports net of the system bars and
  API 36 reports as the whole viewport, so a 731dp panel trips this on both but a
  851dp one trips it on neither. That asymmetry is correct - API 24 really does
  hand the app ~72dp less.
-->
<resources>
    <dimen name="home_section_gap">16dp</dimen>
    <dimen name="home_content_padding_top">16dp</dimen>
    <dimen name="home_playlist_row_height">197dp</dimen>
</resources>
