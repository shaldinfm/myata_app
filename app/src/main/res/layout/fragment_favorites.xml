<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C3F5F">

        <LinearLayout
            android:id="@+id/favorites_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:context=".fragments.FavoritesFragment">

            <!-- Header -->
            <!-- Header with more air -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="70dp"
                android:layout_marginBottom="24dp"
                android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.24_32"
                android:text="ВАША КОЛЛЕКЦИЯ"
                android:textColor="#FFFFFF" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#0F253E"
                app:cardCornerRadius="24dp"
                app:strokeColor="#000000"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Export Buttons Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_export_txt"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Скачать TXT"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.12_16"
                            android:gravity="center"
                            android:background="@drawable/pill_button_bg"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/btn_export_csv"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Скачать CSV"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Myata.Montserrat.Medium.12_16"
                            android:gravity="center"
                            android:background="@drawable/pill_button_bg"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E3754"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"/>

                    <!-- Favorites List with scrolling air -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_favorites"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:padding="16dp"
                        android:paddingBottom="30dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_heart_outline"
                            android:alpha="0.4"
                            app:tint="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Твой идеальный плейлист начинается с первого лайка!"
                            android:textColor="#88FFFFFF"
                            android:textAlignment="center"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp"
                            android:textAppearance="@style/TextAppearance.Myata.Onest.Medium.16_28"
                            android:layout_marginTop="16dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Spacer to block tap bar overlap -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp" />


        </LinearLayout>

    </FrameLayout>

</layout>
