<?xml version="1.0" encoding="utf-8"?>
<!--
  The generic person silhouette, used at two sizes: 16dp inside the 40dp entry
  control and 28dp inside the 72dp guest avatar.

  One drawable for both, tinted at the call site, because Figma draws them as the
  same `Avatar Placeholder` vector in one component family and giving them
  separate assets is how the two quietly drift apart.

  Authored white so `android:tint` is the only thing deciding its colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/profile_entry_icon">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z" />
</vector>
