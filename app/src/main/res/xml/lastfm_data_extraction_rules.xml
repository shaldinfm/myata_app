<?xml version="1.0" encoding="utf-8"?>
<!--
  android:dataExtractionRules - backup and device transfer on API 31+ (G6b P3b, P5).

  The API 31+ counterpart of lastfm_backup_rules.xml, which those releases ignore.
  The same exclusions in both places data can leave the device: cloud backup, and
  device-to-device transfer. Everything else keeps its default, so nothing but the
  Last.fm session, the Last.fm scrobble queue and the playback-intent record
  changes.

  `myata_playback_intent` is excluded from BOTH sections for the same reason it is
  excluded on API 24-30: it is one device's playback runtime state, and a restore
  or a transfer that carried it would hand a new phone a station it never chose
  and an intent nobody expressed on it. See lastfm_backup_rules.xml.

  `myata_playback_commands` is excluded from both sections too: it is the durable
  inbox of gestures this device's listener made and the service has not handled
  yet, and on another device the next service start would carry one out. See
  lastfm_backup_rules.xml.

  `myata_sleep_timer_undo` (what `Вернуть` would put back) is excluded from both
  sections for the same reason: it is the timer as it was when this device's
  listener cancelled it, which is a gesture nobody made on another device. Its
  deadline is monotonic, so it is inert off the boot it was measured on as well.
  The armed-timer record keeps its own backup story; only the undo affordance is
  excluded. See lastfm_backup_rules.xml.

  Keep the paths in step with PrefsLastfmSessionStore.FILE,
  LastfmQueueDatabase.FILE, PlaybackIntentStore.FILE, PlaybackCommandInbox.FILE,
  SleepTimerStore.UNDO_FILE and lastfm_backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lastfm_session.xml" />
        <exclude domain="database" path="lastfm_queue" />
        <exclude domain="database" path="lastfm_queue-wal" />
        <exclude domain="database" path="lastfm_queue-shm" />
        <exclude domain="sharedpref" path="myata_playback_intent.xml" />
        <exclude domain="sharedpref" path="myata_playback_commands.xml" />
        <exclude domain="sharedpref" path="myata_sleep_timer_undo.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lastfm_session.xml" />
        <exclude domain="database" path="lastfm_queue" />
        <exclude domain="database" path="lastfm_queue-wal" />
        <exclude domain="database" path="lastfm_queue-shm" />
        <exclude domain="sharedpref" path="myata_playback_intent.xml" />
        <exclude domain="sharedpref" path="myata_playback_commands.xml" />
        <exclude domain="sharedpref" path="myata_sleep_timer_undo.xml" />
    </device-transfer>
</data-extraction-rules>
